          "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3s-1day-daynighttime-single-sensor-southernocean/l2p_flags",
          "label": "L2P flags",
          "localName": "l2p_flags",
          "type": "Field"
        },
