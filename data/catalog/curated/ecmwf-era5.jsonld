      "documentationStatus": "fully-documented",
      "excludedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/powerFlow"
      ],
      "exclusionRationale": "A reanalysis carries no network representation. It is an input to generation availability, never a substitute for a network model.",
      "harvestSource": "curated",
      "hasField": [
        {
          "concept": "https://schema.opengrid.org/concept/grid-concept/airTemperature",
          "dataType": "float32",
          "definition": "Air temperature at two metres above the surface.",
          "fieldId": "t2m",
          "fieldSource": [
            "https://catalog.opengrid.org/ds/ecmwf-era5"
          ],
          "id": "https://catalog.opengrid.org/field/ecmwf-era5/t2m",
          "label": "2 metre temperature",
          "localName": "t2m",
          "required": true,
          "type": "Field",
          "unit": "http://qudt.org/vocab/unit/DEG_C",
          "unitAsStated": "K",
          "valueBasis": "modeled"
        },
        {
          "completenessCaveats": "Accumulated, not instantaneous. A consumer treating the raw value as W/m2 overstates irradiance by a factor of 3600.",
          "concept": "https://schema.opengrid.org/concept/grid-concept/globalHorizontalIrradiance",
          "dataType": "float32",
          "definition": "Shortwave radiation reaching a horizontal surface, accumulated over the hour. Equivalent to global horizontal irradiance once divided by the accumulation period, which is the conversion most consumers forget.",
          "fieldId": "ssrd",
          "fieldSource": [
            "https://catalog.opengrid.org/ds/ecmwf-era5"
          ],
          "id": "https://catalog.opengrid.org/field/ecmwf-era5/ssrd",
          "label": "Surface solar radiation downwards",
          "localName": "ssrd",
          "required": true,
          "type": "Field",
          "unit": "http://qudt.org/vocab/unit/W-PER-M2",
          "unitAsStated": "J m**-2 accumulated over 1 hour",
          "valueBasis": "modeled"
        },
        {
          "completenessCaveats": "Complete over the full record; no gaps.",
          "concept": "https://schema.opengrid.org/concept/grid-concept/windSpeed",
          "dataType": "float32",
          "definition": "Eastward component of the horizontal wind at 100 metres above the surface. Combined with v100 it gives wind speed at approximately modern turbine hub height, which is why ERA5 is usable for wind yield without extrapolation from 10 metres.",
          "fieldId": "u100",
          "fieldSource": [
            "https://catalog.opengrid.org/ds/ecmwf-era5"
          ],
          "id": "https://catalog.opengrid.org/field/ecmwf-era5/u100",
          "label": "100 metre U wind component",
          "localName": "u100",
          "required": true,
          "type": "Field",
          "unit": "http://qudt.org/vocab/unit/M-PER-SEC",
          "valueBasis": "modeled"
        },
        {
          "completenessCaveats": "Not a reservoir inflow. Using it directly as hydro availability without routing overstates responsiveness.",
          "concept": "https://schema.opengrid.org/concept/grid-concept/hydroInflow",
          "dataType": "float32",
          "definition": "Water leaving the surface and sub-surface as runoff, accumulated hourly. Used as a hydro inflow proxy after catchment aggregation.",
          "fieldId": "ro",
          "fieldSource": [
            "https://catalog.opengrid.org/ds/ecmwf-era5"
          ],
          "id": "https://catalog.opengrid.org/field/ecmwf-era5/ro",
          "inferenceBasis": "Resolved to hydro inflow by alt-label match on 'runoff' at confidence 0.87. ERA5 documents this as a land-surface water balance term, not as a hydro inflow; the mapping holds only after catchment aggregation, which this dataset does not perform.",
          "inferredAssignment": true,
          "label": "Runoff",
          "localName": "ro",
          "required": false,
          "type": "Field",
          "unit": "http://qudt.org/vocab/unit/MilliM",
          "valueBasis": "modeled"
        }
      ],
