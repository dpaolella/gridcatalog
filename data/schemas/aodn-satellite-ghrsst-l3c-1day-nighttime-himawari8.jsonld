      "label": "wind_speed",
      "localName": "wind_speed",
      "type": "Field",
      "unitAsStated": "m s-1"
    },
    {
      "dataType": "float64",
      "definition": "time plus sst_dtime gives seconds after 00:00:00 UTC January 1, 1981.",
      "fieldId": "sst_dtime",
      "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3c-1day-nighttime-himawari8/sst_dtime",
      "label": "time difference from reference time",
      "localName": "sst_dtime",
      "type": "Field",
      "unitAsStated": "second"
    },
    {
      "dataType": "float64",
      "definition": "Weighted representative number of swath pixels, per https://imos.org.au/facilities/srs/sstproducts/sstdata0/sstdata-ghrsstfilefields. EXPERIMENTAL_FIELD",
      "fieldId": "sses_count",
      "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3c-1day-nighttime-himawari8/sses_count",
      "label": "SSES count",
      "localName": "sses_count",
      "type": "Field",
      "unitAsStated": "count"
    },
    {
      "dataType": "float64",
      "definition": "Bias estimate derived from L2P bias,following the method described in http://imos.org.au/fileadmin/user_upload/shared/SRS/SST/GHRSST-DOC-basic-v1.0r1.pdf. Subtracting sses_bias from sea_surface_temperature produces a more accurate skin SST estimate",
      "fieldId": "sses_bias",
      "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3c-1day-nighttime-himawari8/sses_bias",
      "label": "SSES bias estimate",
      "localName": "sses_bias",
      "type": "Field",
      "unitAsStated": "kelvin"
    },
    {
      "dataType": "str472",
      "fieldId": "filename",
      "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3c-1day-nighttime-himawari8/filename",
      "localName": "filename",
      "type": "Field"
    },
    {
      "dataType": "float64",
      "definition": "Fractional sea ice cover (unitless) derived from near real-time UKMO OSTIA Daily 0.05 degree L4, an optimal interpolation of the operational near real-time EUMETSAT OSI-SAF SSMIS daily 10 km Level 3 sea ice concentration fields (Good et al., 2020, Remote Sensing, https://dx.doi.org/10.3390/rs12040720).",
      "fieldId": "sea_ice_fraction",
      "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3c-1day-nighttime-himawari8/sea_ice_fraction",
      "label": "sea_ice_fraction",
      "localName": "sea_ice_fraction",
      "type": "Field",
      "unitAsStated": "1"
    },
    {
      "dataType": "float64",
      "definition": "The satellite zenith angle at the time of the SST observations",
      "fieldId": "satellite_zenith_angle",
      "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3c-1day-nighttime-himawari8/satellite_zenith_angle",
      "label": "satellite_zenith angle",
      "localName": "satellite_zenith_angle",
      "type": "Field",
      "unitAsStated": "angular_degree"
    },
    {
      "dataType": "float64",
      "definition": "These flags are important to properly use the data.  Data not flagged as microwave are sourced from an infrared sensor. The lake and river flags are currently not set, but defined in GDS2.0r4. The terminator flag indicates that the sun is near the horizon. The analysis flag indicates high difference from analysis temperatures (differences greater than Analysis Limit). The lowwind flag indicates regions of low wind speed (typically less than the low Wind Limit) per NWP model. The highwind flag indicates regions of high wind speed (typically greater than the high Wind Limit) per NWP model. Other flags may be populated and are for internal use and the definitions may change, so should not be relied on. Use flag_meanings to confirm the flag assignment that can be relied on. Flags greater than 64 only apply to non-land pixels.",
      "fieldId": "l2p_flags",
      "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3c-1day-nighttime-himawari8/l2p_flags",
      "label": "L2P flags",
      "localName": "l2p_flags",
      "type": "Field"
    },
    {
      "dataType": "float64",
      "definition": "These are the overall quality indicators and are used for all GHRSST SSTs. Refer Merchant et al., 2019 (https://doi.org/10.1038/s41597-019-0236-x) for more details for logic and threshold for assigning pixel quality level with use of Bayesian cloud clearing method. For validation applications, please consider quality_level greater than or equal 4 with bias correction. For operational applications, please consider quality_level greater than or equal 4 with bias correction. For qualitative applications, please consider quality_level greater than or equal 3 with or without bias correction.",
      "fieldId": "quality_level",
      "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3c-1day-nighttime-himawari8/quality_level",
      "label": "quality level of SST pixel",
      "localName": "quality_level",
      "type": "Field"
    },
    {
      "dataType": "float64",
      "definition": "Standard deviation estimate derived from L2P standard deviation, following the method described in http://imos.org.au/fileadmin/user_upload/shared/SRS/SST/GHRSST-DOC-basic-v1.0r1.pdf.",
      "fieldId": "sses_standard_deviation",
      "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3c-1day-nighttime-himawari8/sses_standard_deviation",
      "label": "SSES standard deviation estimate",
      "localName": "sses_standard_deviation",
      "type": "Field",
      "unitAsStated": "kelvin"
    }
  ],
