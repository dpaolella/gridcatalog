{
  "@context": "https://catalog.opengrid.org/context/opengrid-datahub.jsonld",
  "hasField": [
    {
      "dataType": "float64",
      "definition": "The skin temperature of the ocean at a depth of approximately 10 microns. SSTs are retrieved by using the Radiative Transfer Model (RTTOV12.3) and Bayesian cloud clearing method based on the ESA CCI SST code developed at the University of Reading",
      "fieldId": "sea_surface_temperature",
      "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3c-1day-nighttime-himawari8/sea_surface_temperature",
      "label": "sea surface skin temperature",
      "localName": "sea_surface_temperature",
      "type": "Field",
      "unitAsStated": "kelvin"
    },
    {
      "dataType": "float64",
      "definition": "The difference between this SST and the previous day's L4 Foundation SST.",
      "fieldId": "dt_analysis",
      "id": "https://catalog.opengrid.org/field/aodn-satellite-ghrsst-l3c-1day-nighttime-himawari8/dt_analysis",
      "label": "deviation from last SST analysis",
      "localName": "dt_analysis",
      "type": "Field",
      "unitAsStated": "Kelvin"
    },
    {
      "dataType": "float64",
      "definition": "Typically represent surface winds (10 meters above the sea surface).",
      "fieldId": "wind_speed",
