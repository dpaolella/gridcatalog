# SHACL shapes for the OpenGrid metadata contract. PRD §4.5, §4.4, §6.
#
# LEVEL PARAMETERISATION (ADR-0004)
# ---------------------------------
# A record publishes at completeness level 1 and is promoted to 2 and 3 as
# detail arrives. A level-3 constraint must therefore not block a level-1
# record.
#
# Every property shape carries og:appliesAtLevel. The runner
# (datahub.validate.runner) builds a shapes graph for a target level by
# detaching every property shape whose level exceeds it, and by dropping node
# shapes above it entirely. The runner contains no list of which constraint
# applies where: the annotation is the mechanism, so adding a constraint at a
# level is a one-line data change.
#
# MESSAGES
# --------
# PRD §10 M1's done-criterion is that an invalid record is rejected "with a
# message pointing at the failing triple". sh:resultMessage carries the focus
# node and path; sh:message must therefore carry the *remedy*. Not "violates
# minCount" but "add og:fieldSource, or change og:valueBasis to measured".
#
# ADVANCED MODE
# -------------
# SPARQL-based targets and constraints are used where a constraint is
# conditional on a value rather than on a class — the geospatial-primary rule,
# the modelled-field rule, the range-request rule. pySHACL must run with
# advanced=True; the runner sets it.

@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix og:   <https://schema.opengrid.org/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ===========================================================================
# Reusable value-space shapes
# ===========================================================================

og:DataDomainConceptShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:property [
    sh:path skos:inScheme ;
    sh:hasValue <https://schema.opengrid.org/concept/data-domain> ;
    sh:minCount 1 ;
    sh:message "og:dataDomain must be a concept from the OpenGrid data-domain scheme (DD1-DD10). A free-text domain is not a domain: PRD §4.1 D3 makes this controlled precisely so a filter can be built on it." ;
  ] .

og:ProvenanceClassConceptShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:property [
    sh:path skos:inScheme ;
    sh:hasValue <https://schema.opengrid.org/concept/provenance-class> ;
    sh:minCount 1 ;
    sh:message "og:provenanceClass must be a concept from the provenance-class scheme: one of primary, curated, modeled, reanalysis, derived, synthetic, osm-derived, institutional." ;
  ] .

og:AccessRestrictionConceptShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:property [
    sh:path skos:inScheme ;
    sh:hasValue <https://schema.opengrid.org/concept/access-restriction> ;
    sh:minCount 1 ;
    sh:message "og:accessRestriction must be a concept from the access-restriction scheme: one of none, account-required, ceii, pii, commercial-paywall, discontinued." ;
  ] .

og:AnalysisTypeConceptShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:property [
    sh:path skos:inScheme ;
    sh:hasValue <https://schema.opengrid.org/concept/analysis-type> ;
    sh:minCount 1 ;
    sh:message "og:supportedAnalysis and og:excludedAnalysis take concepts from the analysis-type scheme." ;
  ] .

og:GridConceptShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:property [
    sh:path skos:inScheme ;
    sh:hasValue <https://schema.opengrid.org/concept/grid-concept> ;
    sh:minCount 1 ;
    sh:message "og:concept must resolve to a concept in the OpenGrid grid-concept scheme. If no concept fits, record an og:conceptGap instead — an unmapped field is never silently omitted (PRD X4)." ;
  ] .

og:QudtUnitShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:message "og:unit must be a unit IRI, never a string. 'MW' is not a unit; <http://qudt.org/vocab/unit/MegaW> is (PRD §4.3 C5)." ;
  sh:or (
    [ sh:pattern "^http://qudt\\.org/vocab/unit/" ]
    [ sh:pattern "^https://schema\\.opengrid\\.org/unit/" ]
  ) .

og:ConceptGapShape a sh:NodeShape ;
  sh:targetClass og:ConceptGap ;
  og:appliesAtLevel 3 ;
  sh:property [
    sh:path og:gapReason ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    og:appliesAtLevel 3 ;
    sh:message "A gap marker must state why no concept fits. A bare gap is indistinguishable from not having looked (PRD X4)." ;
  ] .

# The same rule one level up. A field with no concept carries og:conceptGap; a
# dataset whose source never said how its values were produced carries
# og:provenanceGap. Both say "somebody looked and the answer was not there",
# which is a different claim from silence and the only honest thing to publish
# when the source is genuinely mute (ADR-0011).
og:ProvenanceGapShape a sh:NodeShape ;
  sh:targetClass og:ProvenanceGap ;
  og:appliesAtLevel 1 ;
  sh:property [
    sh:path og:gapReason ;
    sh:minCount 1 ;
    sh:datatype rdf:langString ;
    og:appliesAtLevel 1 ;
    sh:message "A provenance gap must state why the class is absent. A bare gap is indistinguishable from not having looked (PRD X4)." ;
  ] .

# ===========================================================================
# Dataset
# ===========================================================================

og:DatasetShape a sh:NodeShape ;
  sh:targetClass dcat:Dataset ;
  rdfs:label "OpenGrid dataset record" ;

  # ---- D1 identity, level 1 ----
  sh:property [
    sh:path og:persistentId ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
    og:appliesAtLevel 1 ;
    sh:message "og:persistentId must be an IRI — a DOI, a handle or a stable landing URL." ;
  ] ;
  sh:property [
    sh:path og:conceptDoi ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; og:appliesAtLevel 2 ;
    sh:message "The concept DOI names the dataset across versions. Keep it distinct from the version DOI (PRD §4.1 D1)." ;
  ] ;
  sh:property [
    sh:path og:versionDoi ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; og:appliesAtLevel 2 ;
    sh:message "The version DOI names one release." ;
  ] ;

  # ---- D2 description, level 1 ----
  sh:property [
    sh:path dct:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
    og:appliesAtLevel 1 ;
    sh:message "Every record needs exactly one language-tagged dct:title." ;
  ] ;
  sh:property [
    sh:path dct:description ; sh:minCount 1 ; sh:datatype rdf:langString ;
    og:appliesAtLevel 1 ;
    sh:message "Every record needs a dct:description. If the source gave none, the harvester should have left the record at draft rather than publishing an unexplained title." ;
  ] ;
  sh:property [
    sh:path og:summary ; sh:maxCount 1 ; sh:datatype rdf:langString ; og:appliesAtLevel 1 ;
    sh:message "og:summary is the one-line form the list view renders; keep it to one sentence." ;
  ] ;

  # ---- D3 domain, level 1 ----
  sh:property [
    sh:path og:dataDomain ; sh:minCount 1 ; sh:node og:DataDomainConceptShape ;
    og:appliesAtLevel 1 ;
    sh:message "Every record carries at least one og:dataDomain from DD1-DD10." ;
  ] ;

  # ---- D6 provenance class, level 1 ----
  # The cardinality still holds; what changed in ADR-0011 is that an explicit
  # gap satisfies it too. See the sh:or at the end of this shape.
  sh:property [
    sh:path og:provenanceClass ; sh:maxCount 1 ;
    sh:node og:ProvenanceClassConceptShape ; og:appliesAtLevel 1 ;
    sh:message "Every record states how its values came to exist. This caps the Provenance quality grade, so it cannot be left open." ;
  ] ;
  sh:property [
    sh:path og:provenanceGap ; sh:maxCount 1 ;
    sh:node og:ProvenanceGapShape ; og:appliesAtLevel 1 ;
  ] ;

  # ---- D4/D5 upstream, level 2 ----
  sh:property [
    sh:path og:upstreamSource ; sh:nodeKind sh:IRI ; og:appliesAtLevel 2 ;
    sh:message "og:upstreamSource takes IRIs of upstream datasets or sources." ;
  ] ;
  sh:property [
    sh:path prov:wasDerivedFrom ; sh:nodeKind sh:IRI ; og:appliesAtLevel 2 ;
    sh:message "prov:wasDerivedFrom takes IRIs." ;
  ] ;

  # ---- D7 relations, level 2 ----
  sh:property [
    sh:path og:supersededBy ; sh:nodeKind sh:IRI ; sh:maxCount 1 ; og:appliesAtLevel 2 ;
    sh:message "og:supersededBy points at the one record that replaces this one." ;
  ] ;
  sh:property [
    sh:path og:supersedes ; sh:nodeKind sh:IRI ; og:appliesAtLevel 2 ;
    sh:message "og:supersedes points at records this one replaces." ;
  ] ;
  sh:property [
    sh:path og:complements ; sh:nodeKind sh:IRI ; og:appliesAtLevel 2 ;
  ] ;

  # ---- D8 licence, level 1 ----
  sh:property [
    sh:path dct:license ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
    og:appliesAtLevel 1 ;
    sh:message "Every published record states a licence as an absolute IRI — an SPDX identifier where one fits, otherwise a stable URL for the terms plus og:licenseNote. A fabricated licence is worse than a missing one, so a record with no discoverable licence stays at draft rather than guessing (PRD §7.4). The absolute-IRI requirement is not pedantry: the JSON-LD context coerces dct:license to an IRI, so free text like \"CC BY 4.0\" silently becomes a relative IRI that resolves to nothing rather than failing to parse." ;
  ] ;

  # ---- D9/D10 access, level 1 ----
  sh:property [
    sh:path og:accessRestriction ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:node og:AccessRestrictionConceptShape ; og:appliesAtLevel 1 ;
    sh:message "Every record classifies its access barrier, including 'none'." ;
  ] ;
  sh:property [
    sh:path og:anonymousAccess ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
    og:appliesAtLevel 1 ;
    sh:message "og:anonymousAccess is required: it is one of the five Tier 1 criteria and it is what an unauthenticated evaluator filters on." ;
  ] ;
  sh:property [
    sh:path og:bulkDownload ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
    og:appliesAtLevel 1 ;
    sh:message "og:bulkDownload on a dataset says whether the data can be obtained in bulk at all. It lives on og:Distribution too, where it is the precise claim; this is for the case a distribution cannot cover — a reference-only record, which has none. Optional, unlike og:anonymousAccess: a Tier 1 evaluator must know whether an account is needed, and 'bulk availability not established' is a real and common answer (#57)." ;
  ] ;

  # ---- D11 distributions, level 1 ----
  #
  # `sh:minCount 1` used to be here, and the message said "Tier 3 pointers still
  # carry a distribution: the landing page." For 34 of them the seed inventory
  # records no landing page, no DOI and no secondary access — so the loader
  # minted `https://opengrid.org/catalog/no-known-access-path` to satisfy this
  # line, and the UI rendered it as a live "Open at source" button on 23
  # published records. A fabricated URL is exactly what PRD §14.4 forbids, and
  # this constraint was what made fabricating one the only way to publish.
  #
  # The requirement moved to og:AccessPathShape, which asks the same question of
  # a dataset the catalog offers and a different one of a reference-only pointer.
  sh:property [
    sh:path dcat:distribution ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
    sh:message "dcat:distribution points at Distribution nodes by IRI." ;
  ] ;

  # ---- D12 fitness, level 2 ----
  sh:property [
    sh:path og:supportedAnalysis ; sh:node og:AnalysisTypeConceptShape ; og:appliesAtLevel 2 ;
    sh:message "og:supportedAnalysis takes concepts from the analysis-type scheme. Saying what a dataset IS for is the easy half; PRD §D12 asks for both." ;
  ] ;
  sh:property [
    sh:path og:excludedAnalysis ; sh:node og:AnalysisTypeConceptShape ; og:appliesAtLevel 2 ;
    sh:message "og:excludedAnalysis takes concepts from the analysis-type scheme. This is the half users cannot get anywhere else: a catalog that says what a dataset is not for saves a study." ;
  ] ;
  sh:property [
    sh:path og:outputOfAnalysis ; sh:node og:AnalysisTypeConceptShape ; og:appliesAtLevel 2 ;
    sh:message "og:outputOfAnalysis takes concepts from the analysis-type scheme, and says this dataset is a PRODUCT of that analysis rather than an input to it. og:supportedAnalysis is a flat 'relates to' and cannot express direction, which is the half that makes a data supply chain visible: demand forecasting's output in DD4 is capacity expansion's input in DD4, and a modeller who cannot see that is stacking a projection on a projection." ;
  ] ;

  # ---- D4/D5 lineage at the dataset level, level 1 ----
  sh:property [
    sh:path og:derivedFrom ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
    sh:message "og:derivedFrom points by IRI at what this dataset was built from — a catalog record where the upstream is catalogued, the upstream's own URL where it is not. og:derivedFromField already does this per field; a dataset built from another dataset had nowhere to say so, and og:provenanceClass alone is one hop: NREL ATB, a capacity expansion portfolio built on it, and a resource adequacy study built on that are all 'modeled' and read as peers." ;
  ] ;

  # ---- D13 quality flags, level 1 ----
  sh:property [
    sh:path og:qualityFlags ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
  ] ;

  # ---- Usage evidence, level 1, always optional ----
  # Optional at every level and deliberately so. Coverage depends entirely on
  # whether a source records it — the AWS registry has a DataAtWork block, most
  # CKAN and STAC sources have nothing of the kind — so requiring it would fail
  # datasets for their catalogue's schema rather than for anything about them.
  # PRD §14.2: a missing field means not captured, never does not exist.
  sh:property [
    sh:path og:usageEvidence ; sh:nodeKind sh:IRI ; sh:node og:UsageEvidenceShape ;
    og:appliesAtLevel 1 ;
  ] ;

  # ---- D14 spatial, level 1 ----
  sh:property [
    sh:path og:bboxMinLon ; sh:maxCount 1 ; sh:datatype xsd:double ;
    sh:minInclusive -180.0 ; sh:maxInclusive 180.0 ; og:appliesAtLevel 1 ;
    sh:message "og:bboxMinLon is a longitude in EPSG:4326, between -180 and 180." ;
  ] ;
  sh:property [
    sh:path og:bboxMaxLon ; sh:maxCount 1 ; sh:datatype xsd:double ;
    sh:minInclusive -180.0 ; sh:maxInclusive 180.0 ; og:appliesAtLevel 1 ;
    sh:message "og:bboxMaxLon is a longitude in EPSG:4326, between -180 and 180." ;
  ] ;
  sh:property [
    sh:path og:bboxMinLat ; sh:maxCount 1 ; sh:datatype xsd:double ;
    sh:minInclusive -90.0 ; sh:maxInclusive 90.0 ; og:appliesAtLevel 1 ;
    sh:message "og:bboxMinLat is a latitude in EPSG:4326, between -90 and 90." ;
  ] ;
  sh:property [
    sh:path og:bboxMaxLat ; sh:maxCount 1 ; sh:datatype xsd:double ;
    sh:minInclusive -90.0 ; sh:maxInclusive 90.0 ; og:appliesAtLevel 1 ;
    sh:message "og:bboxMaxLat is a latitude in EPSG:4326, between -90 and 90." ;
  ] ;
  sh:property [
    sh:path og:nativeCRS ; sh:maxCount 1 ; sh:datatype xsd:string ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:spatialGranularity ; sh:maxCount 1 ; og:appliesAtLevel 1 ;
    sh:in ( "nodal" "zonal" "gridded" "administrative" "point" "national" "global" ) ;
    sh:message "og:spatialGranularity is one of nodal, zonal, gridded, administrative, point, national, global. It decides whether a dataset can serve power flow at all, so it is controlled." ;
  ] ;
  sh:property [
    sh:path dcat:spatialResolutionInMeters ; sh:maxCount 1 ; sh:datatype xsd:double ;
    sh:minExclusive 0 ; og:appliesAtLevel 1 ;
    sh:message "dcat:spatialResolutionInMeters is the grid cell size or positional precision, in metres, as an xsd:double and positive. DCAT types this xsd:decimal; the context does not, because a JSON number coerced to xsd:decimal yields a decimal-typed literal holding a float and SHACL rejects it — see test_numeric_terms_are_doubles_not_decimals. It is the companion to og:spatialGranularity, not a replacement: the enum answers 'can this serve power flow at all' and cannot distinguish ERA5 at 30 km from NSRDB at 4 km, which is the difference that decides whether either can serve a siting study." ;
  ] ;

  # ---- D15 temporal, level 1 ----
  sh:property [
    sh:path dct:temporal ; sh:maxCount 1 ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:updateCadence ; sh:maxCount 1 ; sh:datatype xsd:string ;
    sh:pattern "^(P(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(\\d+H)?(\\d+M)?(\\d+S)?)?|irregular|on-demand|discontinued)$" ;
    og:appliesAtLevel 1 ;
    sh:message "og:updateCadence is an ISO 8601 duration (P1D, P1Y, PT1H) or one of irregular, on-demand, discontinued. The Currency grade compares elapsed time against it, so it has to be machine-comparable; it is also displayed alongside the grade, so a correctly-scheduled annual dataset does not read as stale next to an hourly one (PRD §F5)." ;
  ] ;

  # ---- D16 grid facets, level 2 ----
  sh:property [ sh:path og:hasTopology ; sh:maxCount 1 ; sh:datatype xsd:boolean ; og:appliesAtLevel 2 ] ;
  sh:property [ sh:path og:hasImpedance ; sh:maxCount 1 ; sh:datatype xsd:boolean ; og:appliesAtLevel 2 ] ;

  # ---- D17/D19 schema, level 2 ----
  sh:property [
    sh:path og:schemaSource ; sh:maxCount 1 ; sh:datatype xsd:string ; og:appliesAtLevel 1 ;
    sh:message "og:schemaSource names the surface and URL a probed schema was read from. It is what makes a wrong field traceable to a wrong parse rather than to nobody-knows (WP-11.4)." ;
  ] ;
  sh:property [
    sh:path og:hasField ; sh:nodeKind sh:IRI ; og:appliesAtLevel 2 ;
    sh:message "A level 2 record describes its fields. If the source documents none, the record stays at level 1 and says so — an empty schema tab dressed as a described dataset is the dishonesty PRD §6 exists to prevent." ;
  ] ;

  # ---- D18 documentation status, level 1 ----
  sh:property [
    sh:path og:documentationStatus ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "fully-documented" "partial" "external-standard-only" "none" ) ;
    og:appliesAtLevel 1 ;
    sh:message "og:documentationStatus is one of fully-documented, partial, external-standard-only, none." ;
  ] ;

  # ---- build additions, level 1 ----
  sh:property [
    sh:path og:completenessLevel ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 3 ;
    og:appliesAtLevel 1 ;
    sh:message "og:completenessLevel is 1, 2 or 3 (PRD §6). There is no level 4; if a record has more than level 3 carries, the schema needs extending, not the record." ;
  ] ;
  sh:property [
    sh:path og:reviewState ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "draft" "in-review" "confirmed" "auto-confirmed" "flagged" ) ; og:appliesAtLevel 1 ;
    sh:message "og:reviewState is one of draft, in-review, confirmed, auto-confirmed, flagged. `confirmed` means a person checked the licence and the access path; `auto-confirmed` means the pipeline substantiated it and nobody has. They are never conflated (ADR-0012)." ;
  ] ;
  sh:property [
    sh:path og:harvestSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    og:appliesAtLevel 1 ;
    sh:message "Every record says where it came from — a harvester id, or 'curated'. Without it a per-source recall audit is impossible (PRD §M3)." ;
  ] ;
  sh:property [
    sh:path og:visibility ; sh:maxCount 1 ;
    sh:in ( "public" "restricted-metadata" "allowlisted-existence" ) ; og:appliesAtLevel 1 ;
    sh:message "og:visibility is one of public, restricted-metadata, allowlisted-existence (PRD §F8)." ;
  ] ;
  sh:property [
    sh:path og:tier ; sh:maxCount 1 ; sh:datatype xsd:integer ;
    sh:minInclusive 1 ; sh:maxInclusive 3 ; og:appliesAtLevel 1 ;
    sh:message "Tier is 1, 2 or 3. It is an internal build-prioritisation fact and is never displayed as a quality signal (PRD §5)." ;
  ] ;

  # ---- level 3 ----
  sh:property [
    sh:path og:hasField ; sh:minCount 1 ; sh:nodeKind sh:IRI ; og:appliesAtLevel 3 ;
    sh:message "A level 3 record has resolved fields. Promotion to 3 is what enables the semantic layer and the link graph, so it cannot be claimed without them." ;
  ] ;

  # ---- D6 + X4, level 1: a class OR an explicit gap, never neither -------
  sh:or (
    [ sh:property [ sh:path og:provenanceClass ; sh:minCount 1 ; sh:node og:ProvenanceClassConceptShape ] ]
    [ sh:property [ sh:path og:provenanceGap ; sh:minCount 1 ; sh:node og:ProvenanceGapShape ] ]
  ) ;
  og:orAppliesAtLevel 1 ;
  sh:message "Every record either states how its values came to exist or carries an explicit og:provenanceGap saying why it cannot. Silence is not an option: a record with no provenance class is indistinguishable from one nobody looked at, and the Provenance grade cannot tell those apart (PRD X4, ADR-0011)." .

# ---- D11 + PRD §5: an access path, or a stated reason there is none ----
#
# Two constraints that together replace one `sh:minCount 1` (see D11 above).
#
# A dataset the catalog offers must answer "where do I get it" — one of the four
# questions the catalog exists to answer. A **reference-only** record does not
# offer anything: it is the PRD §5 feature, a record that exists so a gap is
# visible, and the 34 in the seed inventory are datasets that are
# CEII-designated, commercial, membership-restricted, or superseded. For those
# an access path is not missing metadata; there is nothing to point at.
#
# So the requirement inverts rather than lapsing. A reference-only record with
# no distribution must say **why** it has none, in og:pointerRationale, where a
# reader sees it. Silence is not an option on either side — the same reasoning
# as og:provenanceGap (ADR-0011): a blank is indistinguishable from nobody
# having looked.
#
# SPARQL rather than `sh:or` because the two branches are not alternatives to
# each other. They are one condition on og:referenceOnly with a different
# obligation on each side, and a disjunction would let a real dataset satisfy it
# by declaring itself reference-only.
og:AccessPathShape a sh:NodeShape ;
  sh:targetClass dcat:Dataset ;
  og:appliesAtLevel 1 ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A record with no dcat:distribution cannot answer 'where do I get it', which is one of the four things the catalog exists to do. If there is genuinely no access path, say so — og:referenceOnly true plus og:pointerRationale — rather than inventing a URL to satisfy this (PRD §14.4)." ;
    sh:select """
      SELECT $this WHERE {
        FILTER NOT EXISTS { $this <http://www.w3.org/ns/dcat#distribution> ?dist }
        FILTER NOT EXISTS { $this <https://schema.opengrid.org/ns#referenceOnly> true }
      }
    """ ;
  ] ,
  [
    a sh:SPARQLConstraint ;
    sh:message "A reference-only record with no access path must carry og:pointerRationale saying why there is none — restricted, commercial, superseded, or that the inventory records no reason. The record exists so the gap is visible (PRD §5), and a gap with nothing said about it is indistinguishable from an oversight." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://schema.opengrid.org/ns#referenceOnly> true .
        FILTER NOT EXISTS { $this <http://www.w3.org/ns/dcat#distribution> ?dist }
        FILTER NOT EXISTS { $this <https://schema.opengrid.org/ns#pointerRationale> ?why }
      }
    """ ;
  ] .

# ---- D7: a dataset cannot supersede itself -----------------------------

og:SupersessionShape a sh:NodeShape ;
  sh:targetClass dcat:Dataset ;
  og:appliesAtLevel 2 ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A dataset cannot supersede itself. A self-loop here makes the Currency grade oscillate and makes provenance traversal non-terminating in any implementation that does not guard for it." ;
    sh:select """
      SELECT $this WHERE {
        { $this <https://schema.opengrid.org/ns#supersededBy> $this }
        UNION
        { $this <https://schema.opengrid.org/ns#supersedes> $this }
      }
    """ ;
  ] .

# ---- PRD §4.5 shape 2: geospatial-primary datasets ---------------------

og:GeospatialPrimaryShape a sh:NodeShape ;
  og:appliesAtLevel 1 ;
  rdfs:comment "PRD §4.5: 'A geospatial-primary dataset without og:bbox, og:nativeCRS and og:geometryTypes fails at level 1.' Conditional on a value rather than a class, so the target is a SPARQL selection." ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this <https://schema.opengrid.org/ns#geospatialPrimary> true .
      }
    """ ;
  ] ;
  sh:property [
    sh:path og:bboxMinLon ; sh:minCount 1 ; og:appliesAtLevel 1 ;
    sh:message "A geospatial-primary dataset must declare its extent at level 1 — all four of og:bboxMinLon, og:bboxMinLat, og:bboxMaxLon, og:bboxMaxLat. Without one it cannot be found by anyone searching a region, which for a geospatial dataset is everyone." ;
  ] ;
  sh:property [
    sh:path og:bboxMinLat ; sh:minCount 1 ; og:appliesAtLevel 1 ;
    sh:message "A geospatial-primary dataset must declare og:bboxMinLat at level 1." ;
  ] ;
  sh:property [
    sh:path og:bboxMaxLon ; sh:minCount 1 ; og:appliesAtLevel 1 ;
    sh:message "A geospatial-primary dataset must declare og:bboxMaxLon at level 1." ;
  ] ;
  sh:property [
    sh:path og:bboxMaxLat ; sh:minCount 1 ; og:appliesAtLevel 1 ;
    sh:message "A geospatial-primary dataset must declare og:bboxMaxLat at level 1." ;
  ] ;
  sh:property [
    sh:path og:nativeCRS ; sh:minCount 1 ; og:appliesAtLevel 1 ;
    sh:message "A geospatial-primary dataset must declare og:nativeCRS at level 1. Coordinates without a CRS are not locations." ;
  ] ;
  sh:property [
    sh:path og:geometryTypes ; sh:minCount 1 ; og:appliesAtLevel 1 ;
    sh:message "A geospatial-primary dataset must declare og:geometryTypes at level 1 — point, line, polygon, raster or a combination." ;
  ] .

# ===========================================================================
# Distribution
# ===========================================================================

og:DistributionShape a sh:NodeShape ;
  sh:targetClass dcat:Distribution ;
  rdfs:label "Access path" ;

  sh:property [
    sh:path dcat:accessURL ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
    og:appliesAtLevel 1 ;
    sh:message "Every distribution needs exactly one dcat:accessURL as an IRI. A distribution with no URL is not an access path." ;
  ] ;
  sh:property [
    sh:path dcat:byteSize ; sh:maxCount 1 ; sh:datatype xsd:long ; sh:minInclusive 0 ;
    og:appliesAtLevel 1 ;
    sh:message "dcat:byteSize is a non-negative integer. A negative size is a parse error somewhere upstream, not a fact." ;
  ] ;
  sh:property [
    sh:path dcat:mediaType ; sh:maxCount 1 ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:accessRestriction ; sh:maxCount 1 ; sh:node og:AccessRestrictionConceptShape ;
    og:appliesAtLevel 1 ;
    sh:message "A distribution's access restriction, where it overrides the dataset's, must still be a concept from the access-restriction scheme. The same dataset commonly has an anonymous S3 copy and an account-gated API, and the classification differs between them (PRD §4.2)." ;
  ] ;
  sh:property [
    sh:path og:supportsRangeRequests ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
    og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:corsEnabled ; sh:maxCount 1 ; sh:datatype xsd:boolean ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:subsettingProtocol ; sh:maxCount 1 ;
    sh:in ( "opendap" "thredds" "wcs" "wfs" "ogc-api-coverages" "stac-api" ) ;
    og:appliesAtLevel 1 ;
    sh:message "og:subsettingProtocol is one of opendap, thredds, wcs, wfs, ogc-api-coverages, stac-api, or absent." ;
  ] ;
  sh:property [
    sh:path og:linkHealth ; sh:maxCount 1 ; sh:node og:LinkHealthShape ; og:appliesAtLevel 1 ;
  ] .

og:UsageEvidenceShape a sh:NodeShape ;
  og:appliesAtLevel 1 ;
  rdfs:comment """A study, tutorial or tool that used this dataset.

  Every constraint here exists to stop this becoming a place where a plausible
  citation can be invented. A fabricated reference is worse than none, because a
  reader carries it into their own bibliography and it acquires a second life
  there — PRD §14.4 forbids fabricating a URL, and this is that rule where it
  bites hardest.

  So a title and a resolvable URL are both required: an entry nobody can follow
  is an assertion, not evidence. And og:assertedBy is required because a
  provider's self-report, a citation index and a steward's reading are three
  different kinds of claim, and a reader who cannot tell them apart is being
  asked to trust the weakest one at the strength of the strongest.""" ;
  sh:property [
    sh:path dct:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
    og:appliesAtLevel 1 ;
    sh:message "Usage evidence needs the title of the thing being cited." ;
  ] ;
  sh:property [
    sh:path dcat:accessURL ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
    og:appliesAtLevel 1 ;
    sh:message "Usage evidence needs a resolvable URL. A citation a reader cannot follow is an assertion, not evidence, and is exactly what a model asked for 'studies that used this' will invent." ;
  ] ;
  sh:property [
    sh:path og:assertedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    og:appliesAtLevel 1 ;
    sh:message "Usage evidence must say who asserts it — a harvest source id, or 'curated' for a steward. Anonymous evidence cannot be weighed." ;
  ] ;
  sh:property [
    sh:path og:evidenceKind ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "publication" "tutorial" "tool" ) ; og:appliesAtLevel 1 ;
    sh:message "og:evidenceKind is one of publication, tutorial, tool. A peer-reviewed study and a demo notebook are not the same evidence and must not render the same." ;
  ] ;
  sh:property [
    sh:path og:authorName ; sh:maxCount 1 ; sh:datatype xsd:string ; og:appliesAtLevel 1 ;
  ] .

og:LinkHealthShape a sh:NodeShape ;
  og:appliesAtLevel 1 ;
  sh:property [
    sh:path og:linkHealthStatus ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "verified" "degraded" "unreachable" "redirected" ) ; og:appliesAtLevel 1 ;
    sh:message "Link health status is one of verified, degraded, unreachable, redirected (PRD §F1.10). Any other value would make the exclude-after-three-failures rule undefined." ;
  ] ;
  sh:property [
    sh:path og:consecutiveFailures ; sh:maxCount 1 ; sh:datatype xsd:integer ;
    sh:minInclusive 0 ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:lastProbedAt ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; og:appliesAtLevel 1 ;
  ] .

# ---- PRD §4.5 shape 4: range requests need a chunk index ---------------

og:RangeRequestShape a sh:NodeShape ;
  og:appliesAtLevel 1 ;
  rdfs:comment "PRD §4.5: 'A distribution with og:supportsRangeRequests: true and no og:chunkIndexMethod fails.' Without the index the broker knows a slice is possible and cannot say which bytes, so the capability is unusable." ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this <https://schema.opengrid.org/ns#supportsRangeRequests> true .
      }
    """ ;
  ] ;
  sh:property [
    sh:path og:chunkIndexMethod ; sh:minCount 1 ; og:appliesAtLevel 1 ;
    sh:message "A distribution advertising range requests must say how to find the bytes: set og:chunkIndexMethod (zarr-v2, zarr-v3, parquet-rowgroup, cog-tiles, netcdf4-chunks, hdf5-btree), or set og:supportsRangeRequests false. Advertising a capability the broker cannot use produces a partial-read plan that does not work." ;
  ] .

# ---- hosted copies need a named refresh owner --------------------------

og:HostedCopyShape a sh:NodeShape ;
  og:appliesAtLevel 1 ;
  rdfs:comment """PRD §F2: 'Every hosted copy has a named refresh owner assigned before launch, not after. This is the documented failure mode in every comparable project. Enforce it: a hosted distribution with no owner cannot be published.'

  The refresh-owner rule survives the custody inversion unchanged, and the
  exception list does not. "Hosting is by exception" was written when nothing
  the Hub held was the Hub's own; under the custody rule a registered object —
  a study, an assumption set, a reference model — is held *because it is
  registered*, which is the normal case rather than an exception to one. Hence
  the fifth value.

  It is a separate value rather than a relaxation of the rule, because the
  distinction it draws is the one that matters: four of these five say "this
  lives somewhere else and we took a copy anyway, here is why", and the fifth
  says "this lives here, and that is the promise". A reader who cannot tell
  those apart does not know whether the bytes will still be there next year.

  A registered copy still needs a refresh owner. The reason changes; the
  failure mode it prevents does not.""" ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this <https://schema.opengrid.org/ns#hostedByOpenGrid> true .
      }
    """ ;
  ] ;
  sh:property [
    sh:path og:refreshOwner ; sh:minCount 1 ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
    sh:message "A distribution OpenGrid hosts must name a refresh owner before it is published. An unowned hosted copy is the standard way a data hub accumulates stale mirrors." ;
  ] ;
  sh:property [
    sh:path og:hostingReason ; sh:minCount 1 ;
    sh:in ( "format" "fragile-source" "charges-user" "etl-output" "registered" ) ;
    og:appliesAtLevel 1 ;
    sh:message "State why OpenGrid holds these bytes: 'registered' for an object the Hub is the custodian of, or one of the four exceptions for a copy of somebody else's data — format, fragile-source, charges-user, etl-output." ;
  ] .

# ===========================================================================
# Field
# ===========================================================================

og:FieldShape a sh:NodeShape ;
  sh:targetClass og:Field ;
  rdfs:label "Field-level metadata" ;

  # ---- C1/C2/C3, level 2 ----
  sh:property [
    sh:path og:localName ; sh:minCount 1 ; sh:maxCount 1 ; og:appliesAtLevel 2 ;
    sh:message "A field must carry the name it actually has in the data. Without it the schema tab describes a dataset the user cannot recognise." ;
  ] ;
  sh:property [
    sh:path og:label ; sh:minCount 1 ; sh:datatype rdf:langString ; og:appliesAtLevel 2 ;
    sh:message "A field needs a human-readable label." ;
  ] ;
  sh:property [
    sh:path og:definition ; sh:minCount 1 ; sh:datatype rdf:langString ; og:appliesAtLevel 2 ;
    sh:message "A field needs a definition. PRD §4.3 C2 is explicit that this is capturable even when the source documents it only externally — cite the external document rather than leaving it blank." ;
  ] ;
  sh:property [
    sh:path og:dataType ; sh:minCount 1 ; sh:maxCount 1 ; og:appliesAtLevel 2 ;
    sh:message "A field needs a data type." ;
  ] ;

  # ---- C6, level 2 ----
  sh:property [
    sh:path og:valueBasis ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "measured" "estimated" "modeled" "synthetic" ) ; og:appliesAtLevel 2 ;
    sh:message "og:valueBasis is one of measured, estimated, modeled, synthetic. It determines the Provenance grade and it is the difference between an observation and an assumption." ;
  ] ;

  # ---- C10, level 2 ----
  sh:property [
    sh:path og:required ; sh:maxCount 1 ; sh:datatype xsd:boolean ; og:appliesAtLevel 2 ;
  ] ;

  # ---- C5, level 3 ----
  sh:property [
    sh:path og:unit ; sh:maxCount 1 ; sh:node og:QudtUnitShape ; og:appliesAtLevel 3 ;
    sh:message "og:unit must be a unit IRI from QUDT or the OpenGrid unit registry, never a string. 'MW' is not a unit; <http://qudt.org/vocab/unit/MegaW> is (PRD §4.3 C5)." ;
  ] ;

  # ---- C7/C8, level 3 ----
  sh:property [
    sh:path og:fieldSource ; sh:nodeKind sh:IRI ; og:appliesAtLevel 3 ;
  ] ;
  sh:property [
    sh:path og:derivedFromField ; sh:nodeKind sh:IRI ; og:appliesAtLevel 3 ;
  ] ;

  # ---- C4 + X4, level 3: a concept OR an explicit gap, never neither ----
  sh:or (
    [ sh:property [ sh:path og:concept ; sh:minCount 1 ; sh:node og:GridConceptShape ] ]
    [ sh:property [ sh:path og:conceptGap ; sh:minCount 1 ; sh:node og:ConceptGapShape ] ]
  ) ;
  og:orAppliesAtLevel 3 ;
  sh:message "At level 3 every field either resolves to a concept or carries an explicit og:conceptGap saying why it does not. Silence is not an option: a field omitted from the crosswalk is indistinguishable from a field nobody looked at (PRD X4)." .

# ---- PRD §4.5 shape 1: a modelled value must record where it came from --

og:ModelledFieldShape a sh:NodeShape ;
  og:appliesAtLevel 2 ;
  rdfs:comment "PRD §4.5: 'A field with og:valueBasis of estimated or modeled and no og:derivedFromField and no og:fieldSource fails.' This is the constraint that stops a modelled number from passing as an observation." ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this <https://schema.opengrid.org/ns#valueBasis> ?basis .
        FILTER (?basis IN ("estimated", "modeled"))
      }
    """ ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "This field is marked estimated or modeled but records no origin. Add og:fieldSource (where the input came from) or og:derivedFromField (which source field it was computed from), or change og:valueBasis to measured. A modelled value with no lineage cannot be graded above Provenance D and should not be published as if it could." ;
    sh:select """
      SELECT $this WHERE {
        FILTER NOT EXISTS { $this <https://schema.opengrid.org/ns#fieldSource> ?s }
        FILTER NOT EXISTS { $this <https://schema.opengrid.org/ns#derivedFromField> ?d }
      }
    """ ;
  ] .

# ---- X3: an enriched value states model and prompt version -------------

og:EnrichmentBasisShape a sh:NodeShape ;
  og:appliesAtLevel 1 ;
  rdfs:comment "PRD X3 and ADR-0005: every enriched field is tagged og:enrichmentBasis 'inferred' with the model and prompt version. Enforced as a shape so it cannot be skipped by a prompt change." ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this <https://schema.opengrid.org/ns#enrichmentBasis> ?basis .
      }
    """ ;
  ] ;
  sh:property [
    sh:path og:enrichmentBasis ; sh:in ( "inferred" "source-confirmed" "steward-authored" ) ;
    og:appliesAtLevel 1 ;
    sh:message "og:enrichmentBasis is one of inferred, source-confirmed, steward-authored." ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An inferred value must name the model and the prompt version that produced it. Without both, a bad prompt's output cannot be identified or revoked in bulk (ADR-0005)." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://schema.opengrid.org/ns#enrichmentBasis> "inferred" .
        FILTER NOT EXISTS {
          $this <https://schema.opengrid.org/ns#enrichmentModel> ?m .
          $this <https://schema.opengrid.org/ns#enrichmentPromptVersion> ?v .
        }
      }
    """ ;
  ] .

# ---- X3: an inferred concept assignment states its basis ---------------

og:InferredConceptShape a sh:NodeShape ;
  og:appliesAtLevel 3 ;
  rdfs:comment "PRD X3: 'An inferred concept assignment must be flagged as inferred with a stated basis.'" ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this <https://schema.opengrid.org/ns#inferredAssignment> true .
      }
    """ ;
  ] ;
  sh:property [
    sh:path og:inferenceBasis ; sh:minCount 1 ; sh:datatype rdf:langString ;
    og:appliesAtLevel 3 ;
    sh:message "An inferred concept assignment must state on what basis — an alt-label match, an embedding similarity above threshold, a steward's judgement. 'Inferred' without a basis is unfalsifiable." ;
  ] .

# ===========================================================================
# Quality grades
# ===========================================================================

og:QualityGradeShape a sh:NodeShape ;
  sh:targetClass og:QualityGrade ;
  og:appliesAtLevel 2 ;
  sh:property [
    sh:path og:facet ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "provenance" "documentation" "currency" ) ; og:appliesAtLevel 2 ;
    sh:message "There are exactly three facets: provenance, documentation, currency. There is no composite, and adding one is forbidden (ADR-0007)." ;
  ] ;
  sh:property [
    sh:path og:grade ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "A" "B" "C" "D" ) ;
    og:appliesAtLevel 2 ;
    sh:message "A grade is A, B, C or D." ;
  ] ;
  sh:property [
    sh:path og:gradeRationale ; sh:minCount 1 ; sh:datatype rdf:langString ;
    og:appliesAtLevel 2 ;
    sh:message "Every grade carries a concrete human-readable reason. A bare letter is not explainable and fails PRD principle 6." ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "The Currency facet does not use grade C. PRD §F5 leaves it deliberately unused rather than inventing a level to fill it; §12.3 carries the question of whether to define one." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://schema.opengrid.org/ns#facet> "currency" .
        $this <https://schema.opengrid.org/ns#grade> "C" .
      }
    """ ;
  ] .

# ===========================================================================
# THE REGISTRY TYPES
#
# A dataset record describes something somebody else holds. These four *are*
# the thing: the Hub holds their bytes, promises they will not move, and issues
# a citation that has to still resolve in five years (docs/architecture.md).
# That promise is the whole product, so every constraint below exists to stop
# the registry making a claim it cannot keep.
#
# All at level 1. The completeness ladder (ADR-0004) exists because a harvested
# dataset arrives thin and thickens as detail is found; a registered object
# arrives complete or it is not registered, because somebody sat down and
# submitted it. There is no level at which a study may omit who filed it.
# ===========================================================================

og:StudyShape a sh:NodeShape ;
  sh:targetClass og:Study ;
  og:appliesAtLevel 1 ;
  rdfs:comment """A filing, a paper, or an intervention responding to one.

  The two constraints that matter are the frozen/citation pair and the parent
  pointer.

  **Frozen implies citable.** og:frozenAt is a promise that this version will
  not change; og:citationId is the handle somebody puts in a bibliography. A
  record carrying the promise without the handle invites a citation of a
  moving target, which is the failure the registry exists to prevent, so the
  SPARQL constraint below refuses it.

  **An intervention names what it intervenes in.** og:studyKind
  "intervention" without og:parentStudy is an assertion floating free of the
  filing it contests, and a regulator reading it cannot put the two side by
  side — which is the entire evaluation user story.""" ;
  sh:property [
    sh:path dct:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
    og:appliesAtLevel 1 ;
    sh:message "A study needs a title." ;
  ] ;
  sh:property [
    sh:path og:studyKind ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "filing" "intervention" "academic" "reanalysis" ) ; og:appliesAtLevel 1 ;
    sh:message "og:studyKind is one of filing, intervention, academic, reanalysis. A utility's filing and an intervenor's response to it carry different weight and must not render the same." ;
  ] ;
  sh:property [
    sh:path dct:publisher ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
    og:appliesAtLevel 1 ;
    sh:message "A study names who filed it. An unattributed filing cannot be weighed against the party it is about." ;
  ] ;
  sh:property [
    sh:path og:analysisType ; sh:minCount 1 ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
    sh:message "A study states its analysis type from the analysis-type scheme (vocab/og-analysis-type.ttl) — an IRP, a production-cost run and a power-flow study answer different questions." ;
  ] ;
  sh:property [
    sh:path og:hasAssumptionSet ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
    og:appliesAtLevel 1 ;
    sh:message "A study without an assumption set is a PDF. The assumption set is the thing an intervenor forks and a regulator compares, and registering a study that has none defeats the purpose of registering it." ;
  ] ;
  sh:property [
    sh:path og:docket ; sh:maxCount 1 ; sh:datatype xsd:string ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:jurisdiction ; sh:maxCount 1 ; sh:datatype rdf:langString ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:frozenAt ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:citationId ; sh:maxCount 1 ; sh:datatype xsd:string ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:parentStudy ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A frozen study needs og:citationId. og:frozenAt promises this version will not change; without a citation handle the promise is unusable, and a reader cites a moving target." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://schema.opengrid.org/ns#frozenAt> ?frozen .
        FILTER NOT EXISTS { $this <https://schema.opengrid.org/ns#citationId> ?cite }
      }
    """ ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An intervention names the study it contests, with og:parentStudy. Without it the comparison the evaluation stories are built on has nothing to compare against." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://schema.opengrid.org/ns#studyKind> "intervention" .
        FILTER NOT EXISTS { $this <https://schema.opengrid.org/ns#parentStudy> ?parent }
      }
    """ ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A study cannot be its own parent." ;
    sh:select """
      SELECT $this WHERE { $this <https://schema.opengrid.org/ns#parentStudy> $this }
    """ ;
  ] .

# ---- assumption sets ---------------------------------------------------

og:AssumptionSetShape a sh:NodeShape ;
  sh:targetClass og:AssumptionSet ;
  og:appliesAtLevel 1 ;
  rdfs:comment """The parameter document a study stands on.

  og:schemaPin is required and is a commit SHA, not a version string, because
  SiennaSchemas publishes no tags (vendor/siennaschemas/PINNED.md) and is
  pre-1.0 with no compatibility promise between releases. A receipt reading
  "validated against sienna-schemas" without saying which sienna-schemas is
  worth nothing six months later.

  A receipt with errors is not a receipt. og:receiptErrors > 0 on a registered
  set means the Hub accepted a document its own validator rejected, which is
  the one thing an intake receipt exists to make impossible.""" ;
  sh:property [
    sh:path dct:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
    og:appliesAtLevel 1 ;
    sh:message "An assumption set needs a title." ;
  ] ;
  sh:property [
    sh:path og:schemaPin ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    sh:pattern "^[0-9a-f]{40}$" ; og:appliesAtLevel 1 ;
    sh:message "og:schemaPin is the 40-character SiennaSchemas commit SHA this document validated against. Upstream publishes no tags and promises no compatibility below 1.0, so a version string would not identify anything." ;
  ] ;
  sh:property [
    sh:path og:hasAssumption ; sh:minCount 1 ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
    sh:message "An assumption set with no assumptions in it is an empty claim." ;
  ] ;
  sh:property [
    sh:path og:receiptErrors ; sh:maxCount 1 ; sh:datatype xsd:integer ;
    sh:minInclusive 0 ; sh:maxInclusive 0 ; og:appliesAtLevel 1 ;
    sh:message "A registered assumption set validated clean. A non-zero error count means the Hub published a document its own validator rejected — record the failed attempt outside the registry, not in it." ;
  ] ;
  sh:property [
    sh:path og:receiptWarnings ; sh:maxCount 1 ; sh:datatype xsd:integer ;
    sh:minInclusive 0 ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:forkedFrom ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An assumption set cannot be forked from itself." ;
    sh:select """
      SELECT $this WHERE { $this <https://schema.opengrid.org/ns#forkedFrom> $this }
    """ ;
  ] .

og:AssumptionShape a sh:NodeShape ;
  sh:targetClass og:Assumption ;
  og:appliesAtLevel 1 ;
  rdfs:comment """One parameter value, keyed to the Sienna field it sets.

  og:assumptionPath is a path into the vendored schemas rather than a free
  label, which is what lets two assumption sets be diffed by machine instead
  of by eye — 'return_on_equity' and 'ROE' are the same number under two
  spellings and a string-matched diff reports them as a disagreement.

  The justification rule is the fork screen's required one-liner, enforced
  where it cannot be skipped: a value inherited from a parent needs no
  defence, a value that CHANGED one always does. That asymmetry is the whole
  point — it makes an intervenor state, once, why this number and not that
  one, and it is what a regulator reads first.""" ;
  sh:property [
    sh:path og:assumptionPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    og:appliesAtLevel 1 ;
    sh:message "An assumption names the Sienna field path it sets, e.g. 'Investments/Financials/TechnologyFinancialData#return_on_equity'. A free-text label cannot be diffed against another set." ;
  ] ;
  sh:property [
    sh:path og:assumptionValue ; sh:minCount 1 ; sh:maxCount 1 ; og:appliesAtLevel 1 ;
    sh:message "An assumption needs a value." ;
  ] ;
  sh:property [
    sh:path og:unit ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:valueBasis ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "measured" "estimated" "modeled" "synthetic" ) ; og:appliesAtLevel 1 ;
    sh:message "An assumption states whether its value was measured, estimated, modeled or synthetic. A filed number whose basis is unstated cannot be argued with." ;
  ] ;
  sh:property [
    sh:path og:fieldSource ; sh:minCount 1 ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
    sh:message "An assumption cites where its value came from. 'Trace every data source behind a financing proposal' is a query over this predicate, and an assumption without one breaks the chain silently." ;
  ] ;
  sh:property [
    sh:path og:inheritedFrom ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:justification ; sh:maxCount 1 ; sh:datatype rdf:langString ; og:appliesAtLevel 1 ;
  ] .

# ---- reference models --------------------------------------------------

og:ReferenceModelShape a sh:NodeShape ;
  sh:targetClass og:ReferenceModel ;
  og:appliesAtLevel 1 ;
  rdfs:comment """A network with a declared fidelity.

  The Hub vision asks: "Is fidelity a declared, machine-readable field on each
  reference model, or prose in a README? Without a declared value, the
  escalation path from indicative to authoritative has no defined step." This
  shape is the answer — og:fidelityClass is required and closed, so the step
  exists.

  og:questionClassPartition is deliberately NOT a controlled scheme. Which
  classes of question a public network is valid for is an agreement study's
  output, not something enumerable in advance, and the vision says so. The
  class is therefore free text and og:robustnessBasis carries the weight: a
  network may claim a question class is "robust" only by naming what
  established it. An unevidenced robust claim is exactly the over-reach that
  makes a commission discount the whole exercise, so the SPARQL constraint
  refuses it — while "unknown" needs nothing, because admitting ignorance
  costs a reader nothing.""" ;
  sh:property [
    sh:path og:fidelityClass ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "indicative" "screening" "authoritative" ) ; og:appliesAtLevel 1 ;
    sh:message "og:fidelityClass is indicative, screening or authoritative. Declaring it is what gives the escalation path a defined step; prose in a README does not." ;
  ] ;
  sh:property [
    sh:path og:questionClassPartition ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:networkElementCount ; sh:maxCount 1 ; sh:datatype xsd:integer ;
    sh:minInclusive 0 ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:schemaPin ; sh:maxCount 1 ; sh:datatype xsd:string ;
    sh:pattern "^[0-9a-f]{40}$" ; og:appliesAtLevel 1 ;
    sh:message "og:schemaPin is the 40-character SiennaSchemas commit SHA this model serialises against." ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An authoritative reference model states what its authority rests on: at least one question class with og:robustnessBasis. Authority asserted without evidence is the claim a commission discounts, and it takes the rest of the record down with it." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://schema.opengrid.org/ns#fidelityClass> "authoritative" .
        FILTER NOT EXISTS {
          $this <https://schema.opengrid.org/ns#questionClassPartition> ?qc .
          ?qc <https://schema.opengrid.org/ns#robustnessBasis> ?basis .
        }
      }
    """ ;
  ] .

og:QuestionClassShape a sh:NodeShape ;
  sh:targetClass og:QuestionClass ;
  og:appliesAtLevel 1 ;
  rdfs:comment """One row of the robust / fragile / unknown partition.

  The vision is explicit that this is a partition and not a single fidelity
  number, because "framing it as accuracy invites a result that says the
  synthetic network is bad, which is both true and beside the point".""" ;
  sh:property [
    sh:path og:questionClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
    og:appliesAtLevel 1 ;
    sh:message "Name the class of question, e.g. 'relative system cost between two capacity portfolios'." ;
  ] ;
  sh:property [
    sh:path og:robustness ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ( "robust" "fragile" "unknown" ) ; og:appliesAtLevel 1 ;
    sh:message "og:robustness is robust, fragile or unknown. Three values, not a score: a number here would be averaged with something and the partition is the point." ;
  ] ;
  sh:property [
    sh:path og:robustnessBasis ; sh:maxCount 1 ; sh:datatype rdf:langString ; og:appliesAtLevel 1 ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A 'robust' question class names what established it — an agreement study, a reproduced result, a published comparison. 'fragile' and 'unknown' need nothing: admitting a limit costs the reader nothing, claiming one does." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://schema.opengrid.org/ns#robustness> "robust" .
        FILTER NOT EXISTS { $this <https://schema.opengrid.org/ns#robustnessBasis> ?basis }
      }
    """ ;
  ] .

# ---- run records -------------------------------------------------------

og:RunRecordShape a sh:NodeShape ;
  sh:targetClass og:RunRecord ;
  og:appliesAtLevel 1 ;
  rdfs:comment """Somebody executed a case. Not the Hub.

  "Data transformation and solving" is out of scope for the Hub and two of the
  vision's unresolved questions ask whether it ever hosts compute. A registry
  that shows results without naming who produced them answers both questions
  in the affirmative by implication, so og:executedBy is required and is never
  the Hub.

  og:caseHash identifies the document actually solved, not the study it
  belongs to. Two runs of "the same" study on an edited case are different
  runs; without the hash nothing distinguishes them and a re-run that quietly
  changed an input reads as a reproduction.""" ;
  sh:property [
    sh:path og:ranAssumptionSet ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
    og:appliesAtLevel 1 ;
    sh:message "A run record names the assumption set that was run." ;
  ] ;
  sh:property [
    sh:path og:onReferenceModel ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
    og:appliesAtLevel 1 ;
    sh:message "A run record names the network it ran on. The same assumptions on two networks are two results, and a reader who cannot tell which is which will average them." ;
  ] ;
  sh:property [
    sh:path og:executedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ;
    og:appliesAtLevel 1 ;
    sh:message "Name who executed this run. The Hub registers runs and does not execute them, so an unattributed result implies a compute path the Hub does not have." ;
  ] ;
  sh:property [
    sh:path og:caseHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    sh:pattern "^[0-9a-f]{64}$" ; og:appliesAtLevel 1 ;
    sh:message "og:caseHash is the SHA-256 of the case document that was solved. Without it a re-run on an edited case is indistinguishable from a reproduction." ;
  ] ;
  sh:property [
    sh:path og:tool ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    og:appliesAtLevel 1 ;
    sh:message "Name the tool. A result with no tool cannot be reproduced by anyone." ;
  ] ;
  sh:property [
    sh:path og:toolVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
    og:appliesAtLevel 1 ;
    sh:message "Name the tool version. 'PyPSA' reproduces nothing; 'PyPSA 0.31.2' might." ;
  ] ;
  sh:property [
    sh:path og:executedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
    og:appliesAtLevel 1 ;
    sh:message "A run record is dated." ;
  ] ;
  sh:property [
    sh:path og:solver ; sh:maxCount 1 ; sh:datatype xsd:string ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:wallTimeSeconds ; sh:maxCount 1 ; sh:datatype xsd:double ;
    sh:minInclusive 0 ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:objectiveValue ; sh:maxCount 1 ; sh:datatype xsd:double ; og:appliesAtLevel 1 ;
  ] ;
  sh:property [
    sh:path og:objectiveUnit ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; og:appliesAtLevel 1 ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An objective value carries its unit. A bare number compared against another study's bare number is how two incompatible results get called a disagreement." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://schema.opengrid.org/ns#objectiveValue> ?v .
        FILTER NOT EXISTS { $this <https://schema.opengrid.org/ns#objectiveUnit> ?u }
      }
    """ ;
  ] .
