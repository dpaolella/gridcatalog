{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "dcat": "http://www.w3.org/ns/dcat#",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "qudt": "http://qudt.org/schema/qudt/",
    "schema": "https://schema.org/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "spdx": "http://spdx.org/licenses/",
    "adms": "http://www.w3.org/ns/adms#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "og": "https://schema.opengrid.org/ns#",

    "id": "@id",
    "type": "@type",

    "Dataset": "dcat:Dataset",
    "Distribution": "dcat:Distribution",
    "Field": "og:Field",
    "FileGroup": "og:FileGroup",
    "Layer": "og:Layer",
    "Variable": "og:Variable",
    "Agent": "prov:Agent",

    "__comment_d1": "D1 — identity. The concept DOI names the dataset across versions; the version DOI names one release. Conflating them is the Zenodo trap the PRD calls out, so they are separate terms.",
    "persistentId": { "@id": "og:persistentId", "@type": "@id" },
    "conceptDoi": { "@id": "og:conceptDoi", "@type": "@id" },
    "versionDoi": { "@id": "og:versionDoi", "@type": "@id" },
    "identifier": { "@id": "dct:identifier", "@container": "@set" },
    "version": "dcat:version",
    "versionNotes": "adms:versionNotes",

    "__comment_d2": "D2 — description. summary is the one-line form the list view shows; description is the full text.",
    "title": { "@id": "dct:title", "@language": "en" },
    "description": { "@id": "dct:description", "@language": "en" },
    "summary": { "@id": "og:summary", "@language": "en" },
    "keyword": { "@id": "dcat:keyword", "@container": "@set" },
    "publisher": { "@id": "dct:publisher", "@type": "@id" },
    "creator": { "@id": "dct:creator", "@type": "@id", "@container": "@set" },
    "contactPoint": { "@id": "dcat:contactPoint", "@type": "@id" },
    "landingPage": { "@id": "dcat:landingPage", "@type": "@id" },
    "documentation": { "@id": "foaf:page", "@type": "@id", "@container": "@set" },

    "__comment_d3": "D3 — data domain. A SKOS concept from og-data-domain, never free text.",
    "dataDomain": { "@id": "og:dataDomain", "@type": "@id", "@container": "@set" },

    "__comment_d4_d5": "D4/D5 — provenance. Absent means 'not captured', never 'no source' (PRD principle 2). Multi-hop traversal is a property of the graph, not a field.",
    "upstreamSource": { "@id": "og:upstreamSource", "@type": "@id", "@container": "@set" },
    "wasDerivedFrom": { "@id": "prov:wasDerivedFrom", "@type": "@id", "@container": "@set" },
    "wasGeneratedBy": { "@id": "prov:wasGeneratedBy", "@type": "@id" },
    "upstreamSourceUncaptured": { "@id": "og:upstreamSourceUncaptured", "@type": "xsd:boolean" },

    "__comment_d6": "D6 — provenance class. A concept from og-provenance-class; it caps the Provenance grade. A record whose source does not state one carries an og:provenanceGap instead — the same 'never a silent omission' rule og:conceptGap holds at field level (ADR-0011).",
    "provenanceClass": { "@id": "og:provenanceClass", "@type": "@id" },
    "provenanceGap": { "@id": "og:provenanceGap", "@type": "@id" },
    "ProvenanceGap": "og:ProvenanceGap",

    "__comment_d7": "D7 — version and relation edges.",
    "supersedes": { "@id": "og:supersedes", "@type": "@id", "@container": "@set" },
    "supersededBy": { "@id": "og:supersededBy", "@type": "@id" },
    "complements": { "@id": "og:complements", "@type": "@id", "@container": "@set" },
    "sameConceptAs": { "@id": "og:sameConceptAs", "@type": "@id", "@container": "@set" },

    "__comment_d8_d10": "D8/D9/D10 — access. licenseNote carries the terms when no SPDX identifier fits, which is common for government and inter-governmental licences.",
    "license": { "@id": "dct:license", "@type": "@id" },
    "licenseNote": { "@id": "og:licenseNote", "@language": "en" },
    "rights": { "@id": "dct:rights", "@type": "@id" },
    "attribution": { "@id": "og:attribution", "@language": "en" },
    "redistributionAllowed": { "@id": "og:redistributionAllowed", "@type": "xsd:boolean" },
    "commercialUseAllowed": { "@id": "og:commercialUseAllowed", "@type": "xsd:boolean" },
    "shareAlike": { "@id": "og:shareAlike", "@type": "xsd:boolean" },
    "accessRestriction": { "@id": "og:accessRestriction", "@type": "@id" },
    "anonymousAccess": { "@id": "og:anonymousAccess", "@type": "xsd:boolean" },

    "__comment_d11": "D11 — distributions. Each access path is its own object; the same dataset commonly has an anonymous S3 copy and an account-gated API whose barrier classification differs.",
    "distribution": { "@id": "dcat:distribution", "@type": "@id", "@container": "@set" },
    "accessURL": { "@id": "dcat:accessURL", "@type": "@id" },
    "downloadURL": { "@id": "dcat:downloadURL", "@type": "@id" },
    "mediaType": "dcat:mediaType",
    "format": { "@id": "dct:format", "@type": "@id" },
    "formatLabel": "og:formatLabel",
    "byteSize": { "@id": "dcat:byteSize", "@type": "xsd:long" },
    "bulkDownload": { "@id": "og:bulkDownload", "@type": "xsd:boolean" },
    "supportsRangeRequests": { "@id": "og:supportsRangeRequests", "@type": "xsd:boolean" },
    "corsEnabled": { "@id": "og:corsEnabled", "@type": "xsd:boolean" },
    "chunkIndexMethod": "og:chunkIndexMethod",
    "subsettingProtocol": "og:subsettingProtocol",
    "credentialRequirement": "og:credentialRequirement",
    "requesterPays": { "@id": "og:requesterPays", "@type": "xsd:boolean" },
    "hostedByOpenGrid": { "@id": "og:hostedByOpenGrid", "@type": "xsd:boolean" },
    "hostingReason": "og:hostingReason",
    "refreshOwner": { "@id": "og:refreshOwner", "@type": "@id" },
    "checksum": "og:checksum",

    "__comment_linkhealth": "F1.10-14 — link health. Status is one of verified, degraded, unreachable, redirected.",
    "linkHealth": { "@id": "og:linkHealth", "@type": "@id" },
    "LinkHealth": "og:LinkHealth",
    "linkHealthStatus": "og:linkHealthStatus",
    "lastProbedAt": { "@id": "og:lastProbedAt", "@type": "xsd:dateTime" },
    "consecutiveFailures": { "@id": "og:consecutiveFailures", "@type": "xsd:integer" },
    "probeCadence": "og:probeCadence",
    "excludedFromPlans": { "@id": "og:excludedFromPlans", "@type": "xsd:boolean" },

    "__comment_d12": "D12 — fitness for purpose. Concepts from og-analysis-type. Saying what a dataset is NOT for is the half users cannot get elsewhere.",
    "supportedAnalysis": { "@id": "og:supportedAnalysis", "@type": "@id", "@container": "@set" },
    "excludedAnalysis": { "@id": "og:excludedAnalysis", "@type": "@id", "@container": "@set" },
    "outputOfAnalysis": { "@id": "og:outputOfAnalysis", "@type": "@id", "@container": "@set" },
    "derivedFrom": { "@id": "og:derivedFrom", "@type": "@id", "@container": "@set" },
    "exclusionRationale": { "@id": "og:exclusionRationale", "@language": "en" },

    "__comment_usage": "Usage evidence — a study, tutorial or tool that used this dataset. Evidence of use, NOT a claim about capability: og:supportedAnalysis is a steward saying what the data can support, this is a record of what somebody actually did with it. og:assertedBy names who says so, because a provider's self-report and a steward's reading are different kinds of claim and the reader must be able to tell.",
    "usageEvidence": { "@id": "og:usageEvidence", "@type": "@id", "@container": "@set" },
    "UsageEvidence": "og:UsageEvidence",
    "evidenceKind": "og:evidenceKind",
    "authorName": "og:authorName",
    "assertedBy": "og:assertedBy",

    "__comment_d13": "D13 — quality flags. Not the graded facets; these are the caveats a steward records.",
    "qualityFlags": { "@id": "og:qualityFlags", "@type": "@id" },
    "QualityFlags": "og:QualityFlags",
    "staleness": "og:staleness",
    "caveat": { "@id": "og:caveat", "@language": "en", "@container": "@set" },
    "plannedSuccessor": { "@id": "og:plannedSuccessor", "@type": "@id" },
    "knownIssue": { "@id": "og:knownIssue", "@language": "en", "@container": "@set" },

    "__comment_d14": "D14 — spatial coverage. bbox, CRS and geometry types are mandatory at level 1 for a geospatial-primary dataset.",
    "spatial": { "@id": "dct:spatial", "@type": "@id", "@container": "@set" },
    "spatialLabel": { "@id": "og:spatialLabel", "@language": "en", "@container": "@set" },
    "bbox": { "@id": "og:bbox", "@type": "@id" },
    "bboxMinLon": { "@id": "og:bboxMinLon", "@type": "xsd:double" },
    "bboxMinLat": { "@id": "og:bboxMinLat", "@type": "xsd:double" },
    "bboxMaxLon": { "@id": "og:bboxMaxLon", "@type": "xsd:double" },
    "bboxMaxLat": { "@id": "og:bboxMaxLat", "@type": "xsd:double" },
    "bboxWKT": "og:bboxWKT",
    "geometryWKT": "og:geometryWKT",
    "nativeCRS": "og:nativeCRS",
    "geometryTypes": { "@id": "og:geometryTypes", "@container": "@set" },
    "featureCount": { "@id": "og:featureCount", "@type": "xsd:long" },
    "spatialResolution": "og:spatialResolution",
    "geospatialPrimary": { "@id": "og:geospatialPrimary", "@type": "xsd:boolean" },

    "__comment_d15": "D15 — temporal coverage.",
    "temporal": { "@id": "dct:temporal", "@type": "@id" },
    "PeriodOfTime": "dct:PeriodOfTime",
    "startDate": { "@id": "dcat:startDate", "@type": "xsd:dateTime" },
    "endDate": { "@id": "dcat:endDate", "@type": "xsd:dateTime" },
    "updateCadence": "og:updateCadence",
    "accrualPeriodicity": { "@id": "dct:accrualPeriodicity", "@type": "@id" },
    "timeResolution": "og:timeResolution",
    "weatherYears": { "@id": "og:weatherYears", "@container": "@set" },

    "__comment_d16": "D16 — grid-specific structural facets. spatialGranularity is nodal, zonal, gridded, administrative or point, and it is what decides whether a dataset can serve power flow at all.",
    "voltageClass": { "@id": "og:voltageClass", "@container": "@set" },
    "hasTopology": { "@id": "og:hasTopology", "@type": "xsd:boolean" },
    "hasImpedance": { "@id": "og:hasImpedance", "@type": "xsd:boolean" },
    "spatialGranularity": "og:spatialGranularity",
    "spatialResolutionMeters": { "@id": "dcat:spatialResolutionInMeters", "@type": "xsd:double" },
    "networkElementCount": { "@id": "og:networkElementCount", "@type": "xsd:integer" },

    "__comment_d17_d19": "D17/D19 — schema. Hierarchical structure, not a flattened column list.",
    "fieldSchema": { "@id": "og:fieldSchema", "@type": "@id" },
    "conformsTo": { "@id": "dct:conformsTo", "@type": "@id", "@container": "@set" },
    "hasField": { "@id": "og:hasField", "@type": "@id", "@container": "@set" },
    "__comment_schema_source": "Where a probed schema was read from — the surface and the URL. A wrong field is then traceable to a wrong parse rather than to nobody-knows (WP-11.4).",
    "schemaSource": "og:schemaSource",
    "hasFileGroup": { "@id": "og:hasFileGroup", "@type": "@id", "@container": "@set" },
    "hasLayer": { "@id": "og:hasLayer", "@type": "@id", "@container": "@set" },
    "hasVariable": { "@id": "og:hasVariable", "@type": "@id", "@container": "@set" },
    "hasDimension": { "@id": "og:hasDimension", "@type": "@id", "@container": "@set" },
    "dimensionSize": { "@id": "og:dimensionSize", "@type": "xsd:long" },
    "variableShape": { "@id": "og:variableShape", "@container": "@list" },

    "__comment_d18": "D18 — documentation status.",
    "documentationStatus": "og:documentationStatus",

    "__comment_d20_d21": "D20/D21 — graph and per-layer geospatial schema. Terms exist so data can carry them; PRD §4.1 defers the shapes and the UI to a later version.",
    "hasNodeType": { "@id": "og:hasNodeType", "@type": "@id", "@container": "@set" },
    "hasEdgeType": { "@id": "og:hasEdgeType", "@type": "@id", "@container": "@set" },
    "edgeSource": { "@id": "og:edgeSource", "@type": "@id" },
    "edgeTarget": { "@id": "og:edgeTarget", "@type": "@id" },
    "layerGeometryType": "og:layerGeometryType",
    "layerFeatureCount": { "@id": "og:layerFeatureCount", "@type": "xsd:long" },

    "__comment_c1_c3": "C1/C2/C3 — field identity, meaning and type. Required at level 2.",
    "localName": "og:localName",
    "fieldId": "og:fieldId",
    "label": { "@id": "og:label", "@language": "en" },
    "definition": { "@id": "og:definition", "@language": "en" },
    "definitionSource": { "@id": "og:definitionSource", "@type": "@id" },
    "dataType": "og:dataType",
    "fieldGeometryType": "og:fieldGeometryType",
    "fieldCRS": "og:fieldCRS",
    "dimensionality": { "@id": "og:dimensionality", "@type": "xsd:integer" },
    "fieldRole": "og:fieldRole",

    "__comment_c4_c5": "C4/C5 — the semantic layer's targets. Required at level 3. A unit is a QUDT IRI, never a string; a string unit is a validation failure, not a warning.",
    "concept": { "@id": "og:concept", "@type": "@id" },
    "conceptConfidence": { "@id": "og:conceptConfidence", "@type": "xsd:double" },
    "conceptGap": { "@id": "og:conceptGap", "@type": "@id" },
    "ConceptGap": "og:ConceptGap",
    "gapReason": { "@id": "og:gapReason", "@language": "en" },
    "__comment_gap_candidates": "A gap the resolver could not close because several concepts fit equally. Naming them is more useful to a steward than either a guess or a bare no-match.",
    "candidateConcept": { "@id": "og:candidateConcept", "@type": "@id", "@container": "@set" },
    "unit": { "@id": "og:unit", "@type": "@id" },
    "unitAsStated": "og:unitAsStated",
    "perUnitBasis": { "@id": "og:perUnitBasis", "@type": "xsd:boolean" },

    "__comment_c6": "C6 — value basis. measured, estimated, modeled or synthetic. A modelled field with no recorded source fails validation.",
    "valueBasis": "og:valueBasis",

    "__comment_c7_c8": "C7/C8 — field-level lineage. C8 records WHICH source field, not the transformation.",
    "fieldSource": { "@id": "og:fieldSource", "@type": "@id", "@container": "@set" },
    "derivedFromField": { "@id": "og:derivedFromField", "@type": "@id", "@container": "@set" },

    "__comment_c9": "C9 — code lists. Each categorical VALUE resolves to its own concept, not just the field.",
    "codeList": { "@id": "og:codeList", "@type": "@id" },
    "CodeList": "og:CodeList",
    "codeValue": { "@id": "og:codeValue", "@type": "@id", "@container": "@set" },
    "CodeValue": "og:CodeValue",
    "code": "og:code",
    "codeMeaning": { "@id": "og:codeMeaning", "@language": "en" },

    "__comment_c10": "C10 — completeness of the field itself.",
    "required": { "@id": "og:required", "@type": "xsd:boolean" },
    "completenessCaveats": { "@id": "og:completenessCaveats", "@language": "en" },
    "nullFraction": { "@id": "og:nullFraction", "@type": "xsd:double" },

    "__comment_c11_c16": "C11-C16 — deferred per PRD §4.3. Terms are defined so data may carry them; no shapes enforce them and no UI reads them yet.",
    "valueRange": { "@id": "og:valueRange", "@type": "@id" },
    "minValue": { "@id": "schema:minValue", "@type": "xsd:double" },
    "maxValue": { "@id": "schema:maxValue", "@type": "xsd:double" },
    "joinCandidate": { "@id": "og:joinCandidate", "@type": "@id", "@container": "@set" },
    "geoJoinKey": { "@id": "og:geoJoinKey", "@type": "@id", "@container": "@set" },
    "sameConceptAsField": { "@id": "og:sameConceptAsField", "@type": "@id", "@container": "@set" },

    "__comment_build": "Fields this build adds beyond the Notion spec (PRD §4.1).",
    "completenessLevel": { "@id": "og:completenessLevel", "@type": "xsd:integer" },
    "harvestSource": "og:harvestSource",
    "sourceRecordId": "og:sourceRecordId",
    "reviewState": "og:reviewState",
    "reviewedBy": { "@id": "og:reviewedBy", "@type": "@id" },
    "reviewedAt": { "@id": "og:reviewedAt", "@type": "xsd:dateTime" },
    "lastComputedAt": { "@id": "og:lastComputedAt", "@type": "@id", "@container": "@set" },
    "ComputedSignal": "og:ComputedSignal",
    "signalName": "og:signalName",
    "computedAt": { "@id": "og:computedAt", "@type": "xsd:dateTime" },

    "__comment_x3": "X3 — every enriched value says it was inferred, by which model, under which prompt version. A drafted value with no basis fails validation, so the honesty rule cannot be skipped (ADR-0005).",
    "enrichmentBasis": "og:enrichmentBasis",
    "enrichmentModel": "og:enrichmentModel",
    "enrichmentPromptVersion": "og:enrichmentPromptVersion",
    "enrichedField": { "@id": "og:enrichedField", "@container": "@set" },
    "inferredAssignment": { "@id": "og:inferredAssignment", "@type": "xsd:boolean" },
    "inferenceBasis": { "@id": "og:inferenceBasis", "@language": "en" },

    "__comment_quality": "F5 — three independent facets. There is deliberately no composite term, and adding one would fail tests/conformance (ADR-0007).",
    "qualityGrade": { "@id": "og:qualityGrade", "@type": "@id", "@container": "@set" },
    "QualityGrade": "og:QualityGrade",
    "facet": "og:facet",
    "grade": "og:grade",
    "gradeLabel": { "@id": "og:gradeLabel", "@language": "en" },
    "gradeRationale": { "@id": "og:gradeRationale", "@language": "en" },
    "gradedAt": { "@id": "og:gradedAt", "@type": "xsd:dateTime" },
    "gradeConfirmedBy": { "@id": "og:gradeConfirmedBy", "@type": "@id" },
    "notYetAssessed": { "@id": "og:notYetAssessed", "@type": "xsd:boolean" },

    "__comment_entitlement": "F8 — visibility. public, restricted-metadata or allowlisted-existence. The allow-list itself is operational state and is not in the record.",
    "visibility": "og:visibility",
    "sensitivityTag": { "@id": "og:sensitivityTag", "@container": "@set" },
    "custodian": { "@id": "og:custodian", "@type": "@id" },

    "__comment_tier": "PRD §5 — tier is an internal build-prioritisation fact, never displayed as a quality signal. referenceOnly is the user-facing consequence for tier 3.",
    "tier": { "@id": "og:tier", "@type": "xsd:integer" },
    "referenceOnly": { "@id": "og:referenceOnly", "@type": "xsd:boolean" },
    "pointerRationale": { "@id": "og:pointerRationale", "@language": "en" },
    "accessBarrier": "og:accessBarrier",

    "__comment_links": "F6 — computed pairings live in og:graph/computed and reference records; they are not authored on a record.",
    "DatasetLink": "og:DatasetLink",
    "hasLink": { "@id": "og:hasLink", "@type": "@id", "@container": "@set" },
    "linkTo": { "@id": "og:linkTo", "@type": "@id" },
    "linkFrom": { "@id": "og:linkFrom", "@type": "@id" },
    "linkStrength": { "@id": "og:linkStrength", "@type": "xsd:integer" },
    "linkScore": { "@id": "og:linkScore", "@type": "xsd:double" },
    "linkType": "og:linkType",
    "complementarityDescriptor": { "@id": "og:complementarityDescriptor", "@language": "en" },
    "joinableKey": { "@id": "og:joinableKey", "@type": "@id", "@container": "@set" },
    "sharedWorkflowTag": { "@id": "og:sharedWorkflowTag", "@type": "@id", "@container": "@set" },
    "sharedOriginWarning": { "@id": "og:sharedOriginWarning", "@type": "@id" },
    "SharedOriginWarning": "og:SharedOriginWarning",
    "sharedOrigin": { "@id": "og:sharedOrigin", "@type": "@id" },
    "modelingConsequence": { "@id": "og:modelingConsequence", "@language": "en" },
    "linkReason": { "@id": "og:linkReason", "@language": "en", "@container": "@set" },

    "__comment_registry": "The registry types. A dataset record describes something; these four ARE the thing, and the Hub holds their bytes (docs/architecture.md, custody). og:Study is a filing or paper; og:AssumptionSet is the parameter document it stands on; og:ReferenceModel is a network with a DECLARED fidelity rather than a README's worth of prose; og:RunRecord says a named party executed a named case with a named tool. The Hub registers runs. It does not execute them, so og:executedBy is never the Hub.",

    "Study": "og:Study",
    "studyKind": "og:studyKind",
    "analysisType": { "@id": "og:analysisType", "@type": "@id", "@container": "@set" },
    "jurisdiction": { "@id": "og:jurisdiction", "@language": "en" },
    "docket": "og:docket",
    "frozenAt": { "@id": "og:frozenAt", "@type": "xsd:dateTime" },
    "citationId": "og:citationId",
    "parentStudy": { "@id": "og:parentStudy", "@type": "@id" },
    "hasAssumptionSet": { "@id": "og:hasAssumptionSet", "@type": "@id", "@container": "@set" },
    "boundReferenceModel": { "@id": "og:boundReferenceModel", "@type": "@id", "@container": "@set" },
    "hasRunRecord": { "@id": "og:hasRunRecord", "@type": "@id", "@container": "@set" },

    "__comment_assumptions": "An assumption set is a document of parameter values keyed to Sienna field paths, plus the pin it validated against. Each og:Assumption carries its own source, which is what makes 'trace every data source behind a proposal' a query rather than a reading exercise. og:justification is required only where a forked value DIFFERS from its parent: an inherited value needs no defence, a changed one always does.",

    "AssumptionSet": "og:AssumptionSet",
    "forkedFrom": { "@id": "og:forkedFrom", "@type": "@id" },
    "schemaPin": "og:schemaPin",
    "validationReceipt": { "@id": "og:validationReceipt", "@type": "@id" },
    "receiptErrors": { "@id": "og:receiptErrors", "@type": "xsd:integer" },
    "receiptWarnings": { "@id": "og:receiptWarnings", "@type": "xsd:integer" },
    "hasAssumption": { "@id": "og:hasAssumption", "@type": "@id", "@container": "@set" },
    "Assumption": "og:Assumption",
    "ValidationReceipt": "og:ValidationReceipt",
    "assumptionPath": "og:assumptionPath",
    "assumptionValue": "og:assumptionValue",
    "inheritedFrom": { "@id": "og:inheritedFrom", "@type": "@id" },
    "justification": { "@id": "og:justification", "@language": "en" },

    "__comment_fidelity": "og:fidelityClass answers the Hub vision's open question — 'is fidelity a declared, machine-readable field on each reference model, or prose in a README?' — by being the field. og:questionClassPartition is deliberately NOT a controlled scheme: which classes of question a public network is valid for is a research output (an agreement study), not something enumerable in advance, so the class is free text and og:robustnessBasis is what carries the weight. 'robust' with no basis is an assertion and the shapes refuse it.",

    "ReferenceModel": "og:ReferenceModel",
    "fidelityClass": "og:fidelityClass",
    "questionClassPartition": { "@id": "og:questionClassPartition", "@type": "@id", "@container": "@set" },
    "QuestionClass": "og:QuestionClass",
    "questionClass": { "@id": "og:questionClass", "@language": "en" },
    "robustness": "og:robustness",
    "robustnessBasis": { "@id": "og:robustnessBasis", "@language": "en" },

    "__comment_runs": "A run record is a claim that somebody executed something, so it names them. og:caseHash identifies the document actually solved rather than the study it belongs to — two runs of 'the same' study on an edited case are not the same run, and without the hash nothing distinguishes them.",

    "RunRecord": "og:RunRecord",
    "ranAssumptionSet": { "@id": "og:ranAssumptionSet", "@type": "@id" },
    "onReferenceModel": { "@id": "og:onReferenceModel", "@type": "@id" },
    "tool": "og:tool",
    "toolVersion": "og:toolVersion",
    "solver": "og:solver",
    "caseHash": "og:caseHash",
    "executedAt": { "@id": "og:executedAt", "@type": "xsd:dateTime" },
    "executedBy": { "@id": "og:executedBy", "@language": "en" },
    "wallTimeSeconds": { "@id": "og:wallTimeSeconds", "@type": "xsd:double" },
    "objectiveValue": { "@id": "og:objectiveValue", "@type": "xsd:double" },
    "objectiveUnit": { "@id": "og:objectiveUnit", "@type": "@id" },

    "__comment_dates": "Record lifecycle.",
    "issued": { "@id": "dct:issued", "@type": "xsd:dateTime" },
    "modified": { "@id": "dct:modified", "@type": "xsd:dateTime" },
    "name": "foaf:name",
