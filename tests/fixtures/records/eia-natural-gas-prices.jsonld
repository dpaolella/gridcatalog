      "supportedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/productionCost",
        "https://schema.opengrid.org/concept/analysis-type/marketSimulation"
      ],
      "excludedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/capacityExpansion"
      ],
      "exclusionRationale": "A short-term outlook does not reach the horizon a capacity expansion model needs, and no open forward curve does. Substituting a two-year outlook for a thirty-year fuel path is the error DD7's structural note exists to prevent.",
      "qualityFlags": {
        "id": "https://catalog.opengrid.org/ds/eia-natural-gas-prices#flags",
