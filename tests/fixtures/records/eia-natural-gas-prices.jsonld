      "id": "https://catalog.opengrid.org/ds/eia-natural-gas-prices",
      "type": "Dataset",
      "title": "EIA natural gas prices and Short-Term Energy Outlook",
      "summary": "Historical US natural gas spot and delivered prices, with short-horizon outlook projections.",
      "description": "Henry Hub spot prices, citygate and delivered prices by sector and state, plus the Short-Term Energy Outlook's forward view. DD7's structural note bounds what this can offer: historical prices are open and forward curves are uniformly commercial and will remain so, so a record like this serves backtesting and calibration and cannot serve forward revenue modelling.",
      "keyword": [
        "natural gas",
        "price",
        "Henry Hub",
        "STEO",
        "fuel",
        "EIA"
      ],
      "publisher": "https://catalog.opengrid.org/agent/eia",
