      "commercialUseAllowed": true,
      "shareAlike": false,
      "accessRestriction": "https://schema.opengrid.org/concept/access-restriction/none",
      "anonymousAccess": true,
      "documentationStatus": "fully-documented",
      "completenessLevel": 1,
