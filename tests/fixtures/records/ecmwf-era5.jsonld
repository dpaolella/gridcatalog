      "exclusionRationale": "A reanalysis carries no network representation. It is an input to generation availability, never a substitute for a network model.",
      "qualityFlags": {
        "id": "https://catalog.opengrid.org/ds/ecmwf-era5#flags",
        "type": "QualityFlags",
        "staleness": "current",
        "caveat": [
          "Reanalysis wind speeds are known to be biased low in complex terrain; downscaling is normally required before siting use.",
          "The 31 km grid does not resolve individual wind farms. A cell value is an area average, not a site measurement."
        ]
      },
