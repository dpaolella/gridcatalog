      "licenseNote": "Copernicus Licence v1.2. Free reuse including commercial, with attribution to the Copernicus Climate Change Service. Not an SPDX-listed identifier.",
      "attribution": "Generated using Copernicus Climate Change Service information 2026",
      "redistributionAllowed": true,
      "commercialUseAllowed": true,
      "shareAlike": false,
      "accessRestriction": "https://schema.opengrid.org/concept/access-restriction/none",
      "anonymousAccess": true,
