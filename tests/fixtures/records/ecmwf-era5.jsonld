      "id": "https://catalog.opengrid.org/ds/ecmwf-era5",
      "type": "Dataset",
      "persistentId": "https://cds.climate.copernicus.eu/datasets/reanalysis-era5-single-levels",
      "title": "ECMWF ERA5 reanalysis",
      "summary": "Hourly global atmospheric reanalysis from 1940 to the present, the reference weather input for European and global energy system modelling.",
      "description": "ERA5 is the fifth-generation ECMWF atmospheric reanalysis of the global climate, produced by the Copernicus Climate Change Service. It assimilates observations into a fixed forecast model to produce a physically consistent hourly record on a roughly 31 km grid. In energy modelling it is the dominant source of wind speed, solar irradiance and temperature time series, which makes it the most common shared upstream origin in the catalog: two datasets that appear independent frequently both derive from it.",
      "keyword": [
        "reanalysis",
        "weather",
        "wind",
        "solar",
        "temperature",
        "ERA5",
        "Copernicus"
      ],
      "publisher": "https://catalog.opengrid.org/agent/ecmwf",
