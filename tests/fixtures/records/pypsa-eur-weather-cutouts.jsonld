      "type": "Field",
      "localName": "influx_direct",
      "fieldId": "influx_direct",
      "label": "Direct solar influx",
      "definition": "Direct-beam shortwave radiation on a horizontal surface, derived from the ERA5 radiation fields by atlite's decomposition.",
      "dataType": "float32",
      "unit": "http://qudt.org/vocab/unit/W-PER-M2",
      "concept": "https://schema.opengrid.org/concept/grid-concept/directNormalIrradiance",
      "inferredAssignment": true,
      "inferenceBasis": "Resolved by alt-label similarity at 0.84. atlite's influx_direct is horizontal direct irradiance, whereas the concept is direct NORMAL irradiance; the two differ by the cosine of the solar zenith angle. Recorded as inferred rather than confirmed so a consumer sees the caveat.",
      "valueBasis": "modeled",
      "derivedFromField": [
        "https://catalog.opengrid.org/field/ecmwf-era5/ssrd"
      ],
      "fieldSource": [
        "https://catalog.opengrid.org/ds/ecmwf-era5"
      ],
      "required": true,
      "completenessCaveats": "Horizontal, not normal. A PV model expecting DNI must divide by cos(zenith)."
    }
