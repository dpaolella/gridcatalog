      "type": "Field",
      "localName": "length",
      "fieldId": "length",
      "label": "Line length",
      "definition": "Route length of the line, from the OSM geometry.",
      "dataType": "float64",
      "unit": "http://qudt.org/vocab/unit/KiloM",
      "concept": "https://schema.opengrid.org/concept/grid-concept/branchLength",
      "valueBasis": "measured",
