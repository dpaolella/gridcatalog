      "type": "Field",
      "localName": "v_nom",
      "fieldId": "v_nom",
      "label": "Nominal voltage",
      "definition": "Voltage class of the bus, taken from the OSM voltage tag.",
      "dataType": "float64",
      "unit": "http://qudt.org/vocab/unit/KiloV",
      "concept": "https://schema.opengrid.org/concept/grid-concept/nominalVoltage",
      "valueBasis": "measured",
      "fieldSource": ["https://catalog.opengrid.org/upstream/openstreetmap-power"],
      "required": true,
      "completenessCaveats": "Present where the OSM way carries a voltage tag; inferred from neighbours otherwise, and those rows are not distinguished in the published file."
    },
    {
      "id": "https://catalog.opengrid.org/field/pypsa-eur-grid/s_nom",
      "type": "Field",
      "localName": "s_nom",
      "fieldId": "s_nom",
      "label": "Nominal apparent power rating",
      "definition": "Thermal rating of the line, estimated from voltage class and circuit count using a standard conductor assumption.",
      "dataType": "float64",
      "unit": "http://qudt.org/vocab/unit/MegaV-A",
      "concept": "https://schema.opengrid.org/concept/grid-concept/continuousRating",
      "valueBasis": "modeled",
      "derivedFromField": ["https://catalog.opengrid.org/field/pypsa-eur-grid/v_nom"],
      "fieldSource": ["https://catalog.opengrid.org/upstream/openstreetmap-power"],
      "required": true,
      "completenessCaveats": "A lookup, not a measurement. Real ratings vary with conductor type and ambient conditions by a wide margin."
    },
    {
      "id": "https://catalog.opengrid.org/field/pypsa-eur-grid/x",
      "type": "Field",
      "localName": "x",
      "fieldId": "x",
      "label": "Series reactance",
      "definition": "Line series reactance in ohms, computed from length and a per-kilometre value looked up by voltage class.",
      "dataType": "float64",
      "unit": "http://qudt.org/vocab/unit/OHM",
      "concept": "https://schema.opengrid.org/concept/grid-concept/reactance",
      "valueBasis": "modeled",
      "derivedFromField": ["https://catalog.opengrid.org/field/pypsa-eur-grid/length"],
      "fieldSource": ["https://catalog.opengrid.org/upstream/openstreetmap-power"],
      "required": true,
      "completenessCaveats": "Voltage-class lookup times length. The absence of a measured resistance is why this dataset supports DC and not AC power flow."
    },
