{
  "@context": "https://schema.opengrid.org/context/opengrid-datahub.jsonld",
  "@graph": [
    {
      "id": "https://catalog.opengrid.org/ds/pypsa-eur-grid",
      "type": "Dataset",
      "persistentId": "https://doi.org/10.5281/zenodo.13358976",
      "title": "PyPSA-Eur grid dataset (pre-built OSM network)",
      "summary": "European transmission network extracted from OpenStreetMap and assembled into a PyPSA-ready bus-branch model.",
      "description": "Buses, lines, links, transformers and substations for the European transmission system, reconstructed from OpenStreetMap power infrastructure tags. Electrical parameters are not measured: impedance and thermal rating are estimated from a voltage-class lookup, which is recorded per field so a user can see which numbers are observed and which are assumed. The ODbL share-alike obligation propagates to anything derived from it, which is a redistribution constraint rather than a quality one and is flagged accordingly.",
      "keyword": ["transmission", "OSM", "PyPSA", "Europe", "bus-branch", "network"],
      "publisher": "https://catalog.opengrid.org/agent/pypsa",
      "dataDomain": ["https://schema.opengrid.org/concept/data-domain/DD1"],
      "provenanceClass": "https://schema.opengrid.org/concept/provenance-class/osmDerived",
      "upstreamSource": ["https://catalog.opengrid.org/upstream/openstreetmap-power"],
      "license": "https://spdx.org/licenses/ODbL-1.0",
      "licenseNote": "MIT for the extraction code, ODbL-1.0 for the data. The share-alike obligation propagates to derived data, including anything OpenGrid hosts downstream.",
      "redistributionAllowed": true,
      "commercialUseAllowed": true,
      "shareAlike": true,
      "attribution": "© OpenStreetMap contributors, processed by the PyPSA-Eur developers",
      "accessRestriction": "https://schema.opengrid.org/concept/access-restriction/none",
      "anonymousAccess": true,
      "documentationStatus": "fully-documented",
      "completenessLevel": 3,
      "reviewState": "confirmed",
      "harvestSource": "curated",
      "visibility": "public",
      "tier": 2,
      "spatialLabel": ["Europe"],
      "bbox": [-11.0, 34.0, 32.0, 72.0],
      "nativeCRS": "EPSG:4326",
      "spatialGranularity": "nodal",
      "hasTopology": true,
      "hasImpedance": true,
      "voltageClass": ["220 kV", "300 kV", "380 kV", "400 kV", "500 kV", "750 kV"],
      "temporal": {
        "type": "PeriodOfTime",
        "startDate": "2024-01-01T00:00:00Z",
        "endDate": "2024-08-01T00:00:00Z"
      },
      "updateCadence": "P6M",
      "supportedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/capacityExpansion",
        "https://schema.opengrid.org/concept/analysis-type/productionCost",
        "https://schema.opengrid.org/concept/analysis-type/dcPowerFlow"
      ],
      "excludedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/acPowerFlow",
        "https://schema.opengrid.org/concept/analysis-type/reliabilityAssessment"
      ],
      "exclusionRationale": "Impedances are estimated from voltage class rather than measured, and reactive parameters are absent. A DC power flow tolerates that; an AC solution or an N-1 assessment against real limits does not.",
      "qualityFlags": {
        "id": "https://catalog.opengrid.org/ds/pypsa-eur-grid#flags",
        "type": "QualityFlags",
        "staleness": "current",
        "caveat": [
          "OSM completeness varies by country and is not documented per country. Coverage in one member state is not evidence of coverage in another.",
          "Electrical parameters are voltage-class estimates, not measurements. Every affected field carries og:valueBasis modeled."
        ]
      },
      "distribution": ["https://catalog.opengrid.org/dist/pypsa-eur-grid--zenodo-csv"],
      "hasField": [
        "https://catalog.opengrid.org/field/pypsa-eur-grid/v_nom",
