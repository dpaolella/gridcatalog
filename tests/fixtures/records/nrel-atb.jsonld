      "supportedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/capacityExpansion",
        "https://schema.opengrid.org/concept/analysis-type/marketSimulation"
      ],
      "excludedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/productionCost"
      ],
      "exclusionRationale": "Annual national averages by technology. A dispatch model needs unit-level marginal cost, and applying a technology average to a specific unit misprices the whole merit order.",
