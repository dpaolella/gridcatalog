      "conceptDoi": "https://doi.org/10.5281/zenodo.15527469",
      "title": "Global Transmission Database",
      "summary": "Zonal MW transfer limits by country and voltage class, assembled from public sources by Brinkerink et al.",
      "description": "A global compilation of inter-zonal transmission transfer capacities, organised by country pair and voltage class. Deliberately zonal: it carries no bus-branch topology and no impedances, so it supports capacity expansion and zonal dispatch and cannot support power flow at any level of care. Its value is coverage where DD1 is thinnest.",
      "keyword": ["transmission", "transfer capacity", "NTC", "global", "zonal"],
      "publisher": "https://catalog.opengrid.org/agent/brinkerink-et-al",
      "dataDomain": ["https://schema.opengrid.org/concept/data-domain/DD1"],
      "provenanceClass": "https://schema.opengrid.org/concept/provenance-class/curated",
      "license": "https://spdx.org/licenses/CC-BY-4.0",
      "redistributionAllowed": true,
      "commercialUseAllowed": true,
      "shareAlike": false,
      "accessRestriction": "https://schema.opengrid.org/concept/access-restriction/none",
      "anonymousAccess": true,
      "documentationStatus": "fully-documented",
      "completenessLevel": 3,
      "reviewState": "confirmed",
      "harvestSource": "curated",
      "visibility": "public",
      "tier": 1,
      "spatialLabel": ["Global"],
      "bbox": [-180.0, -90.0, 180.0, 90.0],
      "nativeCRS": "EPSG:4326",
      "spatialGranularity": "zonal",
      "hasTopology": false,
      "hasImpedance": false,
      "temporal": {
        "type": "PeriodOfTime",
        "startDate": "2020-01-01T00:00:00Z",
        "endDate": "2024-01-01T00:00:00Z"
      },
      "updateCadence": "irregular",
      "supportedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/capacityExpansion",
        "https://schema.opengrid.org/concept/analysis-type/productionCost"
      ],
      "excludedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/powerFlow",
        "https://schema.opengrid.org/concept/analysis-type/reliabilityAssessment"
      ],
      "exclusionRationale": "No bus-branch topology and no impedance. DD1's structural note explains why that limit is not a gap in this dataset but a bound on the whole domain: investment-grade US transmission data is CEII-designated and permanently out of reach.",
      "qualityFlags": {
