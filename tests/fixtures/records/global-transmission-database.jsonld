      "localName": "transfer_capacity_mw",
      "fieldId": "transfer_capacity_mw",
      "label": "Inter-zonal transfer capacity",
      "definition": "Maximum power transferable between the two zones named in the row, aggregating the limiting effect of all circuits in that voltage class.",
      "dataType": "float64",
      "unit": "http://qudt.org/vocab/unit/MegaW",
      "concept": "https://schema.opengrid.org/concept/grid-concept/transferCapacity",
