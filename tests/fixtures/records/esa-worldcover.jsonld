        "https://schema.opengrid.org/concept/analysis-type/siting"
      ],
      "excludedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/capacityExpansion"
      ],
      "exclusionRationale": "A land cover raster constrains where capacity can go; it says nothing about how much is needed. It is an input to a siting screen that feeds an expansion model, not an input to the model.",
