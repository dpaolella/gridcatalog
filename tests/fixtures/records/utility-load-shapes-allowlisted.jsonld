      ],
      "provenanceClass": "https://schema.opengrid.org/concept/provenance-class/primary",
      "license": "https://spdx.org/licenses/LicenseRef-Participation-Agreement",
      "licenseNote": "Use is governed by the participation agreement each contributing utility signed. Redistribution outside the participant set is prohibited.",
      "redistributionAllowed": false,
      "commercialUseAllowed": false,
      "accessRestriction": "https://schema.opengrid.org/concept/access-restriction/accountRequired",
      "anonymousAccess": false,
      "credentialRequirement": "Membership of the participating-utility allow-list, managed by the contributing utilities and not by OpenGrid.",
      "accessBarrier": "Allow-listed. The list is the contributors' to manage; OpenGrid stores and enforces it and never arbitrates its contents. The access-restriction scheme classifies this as accountRequired because that is what stands between a caller and the bytes; the fact that the record's existence is also withheld is og:visibility, not an access restriction.",
