      "bboxMinLon": -180.0,
      "bboxMinLat": -62.0,
      "bboxMaxLon": 180.0,
      "bboxMaxLat": 84.0,
      "bboxWKT": "POLYGON((-180.0 -62.0, 180.0 -62.0, 180.0 84.0, -180.0 84.0, -180.0 -62.0))"
    },
    {
      "id": "https://catalog.opengrid.org/upstream/gwa-wrf-mesoscale",
