      "licenseNote": "ODbL 1.0. Share-alike attaches at the database level, so a derived database that joins this model to other data may inherit the obligation.",
      "accessRestriction": "https://schema.opengrid.org/concept/access-restriction/none",
      "anonymousAccess": true,
      "documentationStatus": "fully-documented",
