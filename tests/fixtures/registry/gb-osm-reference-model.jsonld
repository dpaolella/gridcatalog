        "https://catalog.opengrid.org/dist/gb-osm-reference--sienna",
        "https://catalog.opengrid.org/dist/gb-osm-reference--parameters"
      ]
    },
    {
      "id": "https://catalog.opengrid.org/dist/gb-osm-reference--sienna",
