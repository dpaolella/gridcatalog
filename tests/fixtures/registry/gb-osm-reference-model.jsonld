    },
    {
      "id": "https://catalog.opengrid.org/dist/gb-osm-reference--parameters",
      "type": "Distribution",
      "title": "Parameter provenance, JSON",
      "description": "One record per branch: the rule that produced its impedance and rating, the inputs that rule read, and the approximations it is known to make. Also the SHA-256 of each source file the build read, so the derivation can be checked against the Zenodo archive rather than trusted.",
      "accessURL": "https://github.com/dpaolella/gridcatalog/blob/claude/opengrid-hub-demo/data/reference-models/gb-osm/parameters.json",
      "downloadURL": "https://raw.githubusercontent.com/dpaolella/gridcatalog/claude/opengrid-hub-demo/data/reference-models/gb-osm/parameters.json",
      "mediaType": "application/json",
      "format": "JSON",
      "byteSize": 381867,
      "hostedByOpenGrid": true,
      "hostingReason": "registered",
      "refreshOwner": "https://catalog.opengrid.org/agent/opengrid-reference-models"
    },
    {
      "id": "https://catalog.opengrid.org/question-class/gb-osm-corridor-existence",
      "type": "QuestionClass",
      "questionClass": "Where transmission corridors run, and which substations they connect",
      "robustness": "robust",
      "robustnessBasis": "This is the part that is measured rather than derived. Routes, terminals, nominal voltage and circuit counts are OSM survey data carried through unchanged; the coordinates are the mapped substation locations, not synthesised positions."
    },
    {
      "id": "https://catalog.opengrid.org/question-class/gb-osm-topological-exposure",
      "type": "QuestionClass",
      "questionClass": "Which locations are topologically peripheral or singly fed",
      "robustness": "robust",
      "robustnessBasis": "A property of the graph, and the graph is the measured part. Reading it does require the transformers: over lines alone the extract falls into 48 pieces, because OSM models a substation as one bus per voltage level, and a reader who cut the network on lines alone would find isolation everywhere and believe it."
    },
    {
      "id": "https://catalog.opengrid.org/question-class/gb-osm-flow-magnitude",
      "type": "QuestionClass",
      "questionClass": "Power flow magnitudes and line loadings",
      "robustness": "fragile",
      "robustnessBasis": "Flow divides in inverse proportion to impedance, and every impedance here is a class average from a per-kilometre table. Two parallel corridors of the same voltage and length get identical values whatever their real conductors are, so the split between them is an artefact of the estimator. The 45 underground circuits are worse: they carry an overhead type, whose capacitance is an order of magnitude too low and whose reactance is too high."
    },
    {
      "id": "https://catalog.opengrid.org/question-class/gb-osm-contingency-severity",
      "type": "QuestionClass",
      "questionClass": "Contingency severity and reserve requirements",
      "robustness": "unknown"
    },
    {
      "id": "https://catalog.opengrid.org/field/gb-osm/geometry",
      "type": "Field",
      "localName": "geo_json",
      "fieldId": "supplemental_attributes[].geo_json",
      "label": "Substation location and line route",
      "definition": "Point coordinates for each bus and the full-resolution LineString for each circuit, as GeographicInfo supplemental attributes.",
      "dataType": "object",
      "valueBasis": "measured",
      "fieldSource": [
        "https://catalog.opengrid.org/ds/pypsa-eur-grid"
      ],
      "required": true
    },
    {
      "id": "https://catalog.opengrid.org/field/gb-osm/base-voltage",
      "type": "Field",
      "localName": "base_voltage",
      "fieldId": "components.ACBus[].base_voltage",
      "label": "Bus nominal voltage",
      "definition": "Nominal voltage of the substation busbar in kV, as tagged in OpenStreetMap.",
      "dataType": "float64",
      "unit": "https://schema.opengrid.org/concept/unit/kilovolt",
      "valueBasis": "measured",
      "fieldSource": [
        "https://catalog.opengrid.org/ds/pypsa-eur-grid"
      ],
      "required": true
    },
    {
      "id": "https://catalog.opengrid.org/field/gb-osm/line-r",
      "type": "Field",
      "localName": "r",
      "fieldId": "components.Line[].r",
      "label": "Line series resistance",
      "definition": "Series resistance in ohms, estimated as the per-kilometre resistance of the standard overhead line type for the circuit's voltage class, multiplied by route length and divided by the number of parallel circuits.",
      "dataType": "float64",
      "unit": "https://schema.opengrid.org/concept/unit/ohm",
      "valueBasis": "modeled",
      "fieldSource": [
        "https://catalog.opengrid.org/ds/pypsa-eur-grid"
      ],
      "required": true,
      "completenessCaveats": "The source contains no resistance at any voltage. Every value in this column is derived, and parameters.json names the line type and inputs used for each branch. 275 kV takes the 300 kV standard type, there being none of its own. The 45 underground circuits take an overhead type, which is wrong for a cable in a known direction."
    },
    {
      "id": "https://catalog.opengrid.org/field/gb-osm/line-x",
      "type": "Field",
      "localName": "x",
      "fieldId": "components.Line[].x",
      "label": "Line series reactance",
      "definition": "Series reactance in ohms, estimated the same way as resistance: per-kilometre reactance of the standard type for the voltage class, times route length, divided by parallel circuits.",
      "dataType": "float64",
      "unit": "https://schema.opengrid.org/concept/unit/ohm",
      "valueBasis": "modeled",
      "fieldSource": [
        "https://catalog.opengrid.org/ds/pypsa-eur-grid"
      ],
      "required": true,
      "completenessCaveats": "This is the column flow results are most sensitive to, and it is the one with the least evidence behind it: it distinguishes two corridors only by their voltage, length and circuit count."
    },
    {
      "id": "https://catalog.opengrid.org/field/gb-osm/line-rating",
      "type": "Field",
      "localName": "rating",
      "fieldId": "components.Line[].rating",
      "label": "Line thermal rating",
      "definition": "Thermal rating in MVA, estimated as sqrt(3) times nominal voltage times the standard type's nominal current times the number of circuits.",
      "dataType": "float64",
      "unit": "https://schema.opengrid.org/concept/unit/megavolt-ampere",
      "valueBasis": "modeled",
      "fieldSource": [
        "https://catalog.opengrid.org/ds/pypsa-eur-grid"
      ],
      "required": true,
      "completenessCaveats": "A static rating from a conductor table. Real GB ratings are seasonal and in places dynamic, and no season is represented here."
    },
    {
      "id": "https://catalog.opengrid.org/field/gb-osm/transformer-x",
      "type": "Field",
      "localName": "x",
      "fieldId": "components.TransformerCircuit[].x",
      "label": "Transformer reactance",
      "definition": "Series reactance in ohms on the primary base, from a typical supergrid autotransformer: 13% on rating, with rating taken by voltage pair.",
      "dataType": "float64",
      "unit": "https://schema.opengrid.org/concept/unit/ohm",
      "valueBasis": "estimated",
      "fieldSource": [
        "https://catalog.opengrid.org/ds/pypsa-eur-grid"
      ],
      "required": true,
      "completenessCaveats": "The weakest values in the model, and recorded as estimated rather than modeled because there is no per-kilometre table behind them \u2014 only a class value. No public register of GB transformer impedances exists to check them against."
    },
    {
      "id": "https://catalog.opengrid.org/agent/opengrid-reference-models",
      "type": "Agent",
      "name": "OpenGrid Reference Models",
      "pointerRationale": "The team that builds and maintains the Hub's own reference models. Named as refresh owner on every distribution the Hub holds bytes for, because a registered model with no owner is a promise nobody has made."
    }
  ]
