{
  "@context": "https://schema.opengrid.org/context/opengrid-datahub.jsonld",
  "@graph": [
    {
      "id": "https://catalog.opengrid.org/ds/gb-osm-reference",
      "type": [
        "Dataset",
        "ReferenceModel"
      ],
      "title": "OpenGrid Reference: Great Britain (OSM)",
      "summary": "The GB transmission network as mapped in OpenStreetMap \u2014 real substations, real corridors \u2014 with every electrical parameter estimated, because the source has none.",
      "description": "412 substations, 455 circuits and 98 transformers, derived from the PyPSA-Eur prebuilt OSM extract (Zenodo 10.5281/zenodo.13358976 v0.3). Topology, coordinates, nominal voltage, circuit count and route geometry come from the source and are real. Series impedance, shunt susceptance and thermal rating do not exist anywhere in the source and are estimated here from voltage class and route length using PyPSA's standard overhead line types; parameters.json records the rule and the inputs behind every one of them, per branch. There is no demand and no generation: this is a network, not a system, and it cannot be dispatched as it stands. Great Britain only \u2014 the Northern Ireland island under the same country code is a separate network and is excluded, as are the HVDC interconnectors and internal bootstraps, so north-south transfer capability is understated.",
      "fidelityClass": "indicative",
      "networkElementCount": 965,
      "hasTopology": true,
      "hasImpedance": true,
      "voltageClass": [
        "transmission"
      ],
      "spatialGranularity": "nodal",
      "hasField": [
        "https://catalog.opengrid.org/field/gb-osm/geometry",
        "https://catalog.opengrid.org/field/gb-osm/base-voltage",
        "https://catalog.opengrid.org/field/gb-osm/line-r",
        "https://catalog.opengrid.org/field/gb-osm/line-x",
        "https://catalog.opengrid.org/field/gb-osm/line-rating",
        "https://catalog.opengrid.org/field/gb-osm/transformer-x"
      ],
      "supportedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/dcPowerFlow"
      ],
      "excludedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/acPowerFlow",
        "https://schema.opengrid.org/concept/analysis-type/resourceAdequacy",
        "https://schema.opengrid.org/concept/analysis-type/productionCost",
        "https://schema.opengrid.org/concept/analysis-type/capacityExpansion"
      ],
      "exclusionRationale": "Two independent reasons, and either alone is sufficient. There is no generation and no demand, so nothing that dispatches or expands a fleet can run at all. And the impedances are estimated from voltage class rather than measured, with reactive parameters absent \u2014 which a DC solution tolerates and an AC solution does not. DC power flow is listed as supported on the understanding that the modeller brings their own injections: what this model supplies is the network, and it cannot be solved as it stands.",
      "questionClassPartition": [
        "https://catalog.opengrid.org/question-class/gb-osm-corridor-existence",
        "https://catalog.opengrid.org/question-class/gb-osm-topological-exposure",
        "https://catalog.opengrid.org/question-class/gb-osm-flow-magnitude",
        "https://catalog.opengrid.org/question-class/gb-osm-contingency-severity"
      ],
      "schemaPin": "3325d27c8c626a375c7492f1341af139d5686e53",
      "dataDomain": [
        "https://schema.opengrid.org/concept/data-domain/DD1"
      ],
      "provenanceClass": "https://schema.opengrid.org/concept/provenance-class/osmDerived",
      "upstreamSource": [
        "https://catalog.opengrid.org/ds/pypsa-eur-grid"
      ],
      "publisher": "https://catalog.opengrid.org/agent/opengrid-reference-models",
      "license": "https://spdx.org/licenses/ODbL-1.0",
      "redistributionAllowed": true,
