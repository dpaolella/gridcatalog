      "title": "OpenGrid Reference: Cascade Interconnect",
      "summary": "A 90-bus, 129-line synthetic network for an invented service territory. Corresponds to no real system.",
      "description": "Generated by ops/reference-models/build_cascade.py and serialised as a Sienna SystemDocument: 90 buses across three zones, 129 lines, 28 thermal and 34 renewable units, 38 loads. Built to be topologically plausible at system scale and to carry no real asset identity or location, so an intervenor can test a hypothesis on a public network without anyone asserting a result about a real utility's system.",
      "fidelityClass": "screening",
      "networkElementCount": 319,
      "hasTopology": true,
      "hasImpedance": true,
      "voltageClass": [
        "transmission"
      ],
      "spatialGranularity": "nodal",
      "supportedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/capacityExpansion",
        "https://schema.opengrid.org/concept/analysis-type/productionCost",
        "https://schema.opengrid.org/concept/analysis-type/dcPowerFlow"
      ],
      "excludedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/acPowerFlow",
        "https://schema.opengrid.org/concept/analysis-type/resourceAdequacy"
      ],
      "exclusionRationale": "Reactive parameters are absent and the generator fleet is statistically representative rather than unit-accurate. A DC solution tolerates both; an AC solution needs the first and a resource-adequacy study needs the second.",
      "questionClassPartition": [
        "https://catalog.opengrid.org/question-class/cascade-relative-portfolio-cost",
