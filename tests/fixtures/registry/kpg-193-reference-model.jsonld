    },
    {
      "id": "https://catalog.opengrid.org/dist/kpg-193-reference--parameters",
      "type": "Distribution",
      "title": "Conversion provenance, JSON",
      "description": "What this conversion read, what it assumed and what it left behind: the SHA-256 of each upstream file at the pinned v2.0.0 commit, the operating point the case describes, the unit and commitment conventions, and the two upstream inconsistencies found while joining the MATPOWER case to the generator metadata.",
      "accessURL": "https://github.com/dpaolella/gridcatalog/blob/claude/opengrid-hub-demo/data/reference-models/kpg-193/parameters.json",
      "downloadURL": "https://raw.githubusercontent.com/dpaolella/gridcatalog/claude/opengrid-hub-demo/data/reference-models/kpg-193/parameters.json",
      "mediaType": "application/json",
      "format": "JSON",
      "byteSize": 3665,
      "hostedByOpenGrid": true,
      "hostingReason": "registered",
      "refreshOwner": "https://catalog.opengrid.org/agent/opengrid-reference-models"
    },
    {
      "id": "https://catalog.opengrid.org/question-class/kpg-193-dispatch-feasibility",
      "type": "QuestionClass",
      "questionClass": "Whether a dispatch is feasible, and what it costs",
      "robustness": "robust",
      "robustnessBasis": "The thing this model is for, and the only reference model here that answers it at all. Demand, a committed fleet, quadratic cost curves and branch ratings are all present, and the authors validated the system by solving daily unit commitment and hourly AC OPF over a full year. The registered snapshot was checked independently on load: every bus inside its voltage limits, every branch inside its rating, every online unit inside its dispatch limits, 1.26% losses across 66 GW. Costs are in thousands of Korean won and derive from the source's own fuel prices and heat rates."
    },
    {
      "id": "https://catalog.opengrid.org/question-class/kpg-193-regional-balance",
      "type": "QuestionClass",
      "questionClass": "Where generation sits relative to demand, and the transfer between regions",
      "robustness": "robust",
      "robustnessBasis": "What a clustered model is good at, and the reason to cluster. Korea's structure — nuclear and coal on the coasts, demand concentrated around Seoul — survives aggregation onto regional offices, and the two 1,500 MW HVDC links that carry it are in the model and running near their limit in the registered hour. The bus that a plant sits at is a region and that is the right resolution for this question."
    },
    {
      "id": "https://catalog.opengrid.org/question-class/kpg-193-substation-siting",
      "type": "QuestionClass",
      "questionClass": "Which substation a circuit terminates at, or where equipment physically is",
      "robustness": "fragile",
      "robustnessBasis": "The cost of clustering, and the one thing this model should not be mistaken for. A bus is a KEPCO regional office and its coordinate is that office's, not a substation's. The circuits are real and surveyed, but they have been collapsed onto 193 representative nodes, so a line here joins two regions rather than two switchyards. The Hub's Great Britain and Germany models answer this question and this one does not, which is why it is filed at zonal granularity while they are nodal."
    },
    {
      "id": "https://catalog.opengrid.org/question-class/kpg-193-voltage-support",
      "type": "QuestionClass",
      "questionClass": "Voltage support, reactive margin and compensation",
      "robustness": "fragile",
      "robustnessBasis": "Stated by the authors rather than inferred here: \"Various compensation devices, such as shunt capacitors, static synchronous compensators, and tap-changing transformers, are installed in the actual Korean power grid to mitigate voltage issues. However, these devices were not included in the test system.\" They also fix nodal reactive demand at 90% of real power demand. So the voltage profile solves, and it solves on a system missing the equipment that holds voltage up in the real one."
    },
    {
      "id": "https://catalog.opengrid.org/question-class/kpg-193-topology-currency",
      "type": "QuestionClass",
      "questionClass": "Whether the network reflects the grid as it stands today",
      "robustness": "unknown",
      "robustnessBasis": "The authors' own caveat, carried verbatim: \"Data sourced from OSM has uncertain update schedules, which may lead to inaccuracies in the power grid topology represented in the KPG 193 test system.\" Unknown rather than fragile, because neither they nor this catalog can say how far the extract lags the built system, and a guess at the size of an error is worse than naming the error."
    },
    {
      "id": "https://catalog.opengrid.org/field/kpg-193/geometry",
      "type": "Field",
      "localName": "geo_json",
      "fieldId": "supplemental_attributes[].geo_json",
      "label": "Bus location",
      "definition": "Point coordinates for each bus, in WGS 84, from the source's bus metadata.",
      "dataType": "object",
      "valueBasis": "measured",
      "required": true,
      "completenessCaveats": "A real coordinate for a real place, and not a substation. These are the locations of KEPCO's regional offices, onto which the network was clustered. Circuits carry no route geometry in this source, so a map draws them as straight lines between regions rather than along corridors."
    },
    {
      "id": "https://catalog.opengrid.org/field/kpg-193/base-voltage",
      "type": "Field",
      "localName": "base_voltage",
      "fieldId": "components.ACBus[].base_voltage",
      "label": "Bus nominal voltage",
      "definition": "Nominal voltage of the bus in kV. Korea's transmission levels are 154, 345 and 765 kV.",
      "dataType": "float64",
      "unit": "http://qudt.org/vocab/unit/KiloV",
      "valueBasis": "measured",
      "required": true
    },
    {
      "id": "https://catalog.opengrid.org/field/kpg-193/line-x",
      "type": "Field",
      "localName": "x",
      "fieldId": "components.Line[].x",
      "label": "Line series reactance",
      "definition": "Series reactance in per unit on a 100 MVA base, as published in the source's MATPOWER case.",
      "dataType": "float64",
      "valueBasis": "modeled",
      "required": true,
      "completenessCaveats": "Computed upstream from published conductor tables by voltage level and conductor type, not measured per circuit — the same class of estimate the Hub's other two models carry, from a different table. Kept in per unit rather than converted to ohms: 184 of the 385 branches join different nominal voltages with no transformer ratio, so there is no single base voltage to convert them against and picking one would fabricate the answer.",
      "fieldSource": [
        "https://github.com/agm-center/kpg-testgrid/tree/5ab3e25d6d1a84e27d7de6d11169cb6f9a7dd29b"
      ]
    },
    {
      "id": "https://catalog.opengrid.org/field/kpg-193/load-active-power",
      "type": "Field",
      "localName": "active_power",
      "fieldId": "components.PowerLoad[].active_power",
      "label": "Nodal demand",
      "definition": "Active power demand at the bus, per unit on a 100 MVA base, for the hour the case describes.",
      "dataType": "float64",
      "valueBasis": "measured",
      "required": true,
      "completenessCaveats": "One hour, not a profile: 2025-12-31 hour 24, totalling 66,135 MW. `max_active_power` is set equal to it because this document carries no other hour to take a maximum over — the 8,760-hour profile is upstream. Reactive demand is fixed by the authors at 90% of active demand rather than measured."
    },
    {
      "id": "https://catalog.opengrid.org/field/kpg-193/gen-status",
      "type": "Field",
      "localName": "status",
      "fieldId": "components.ThermalStandard[].status",
      "label": "Unit commitment state",
      "definition": "Whether the unit is synchronised in the hour the case describes. ONLINE for 100 units, OFFLINE for 101.",
      "dataType": "string",
      "valueBasis": "modeled",
      "required": true,
      "completenessCaveats": "The output of somebody's optimisation, not a property of the plant. Half the fleet being off is the commitment that hour's AC OPF chose and says nothing about availability — every unit here is `available`, and a study that re-commits should expect to turn them back on.",
      "fieldSource": [
        "https://github.com/agm-center/kpg-testgrid/tree/5ab3e25d6d1a84e27d7de6d11169cb6f9a7dd29b"
      ]
    },
    {
      "id": "https://catalog.opengrid.org/field/kpg-193/gen-cost",
      "type": "Field",
      "localName": "operation_cost",
      "fieldId": "components.ThermalStandard[].operation_cost",
      "label": "Generation cost curve",
      "definition": "Quadratic input-output cost curve in thousands of Korean won per hour against MW, plus start-up and shut-down costs, from the source's gencost block.",
      "dataType": "object",
      "valueBasis": "modeled",
      "required": true,
      "completenessCaveats": "Derived upstream from fuel prices and unit heat rates, both recorded per unit in the source's generator metadata, so the curve is checkable against its inputs rather than asserted. The variable O&M term is zero because the source states none; a plausible figure would ride into every dispatch as real money.",
      "fieldSource": [
        "https://github.com/agm-center/kpg-testgrid/tree/5ab3e25d6d1a84e27d7de6d11169cb6f9a7dd29b"
      ]
    },
    {
      "id": "https://catalog.opengrid.org/agent/kentech-agm-center",
      "type": "Agent",
      "name": "AGM Center, Korea Institute of Energy Technology",
      "pointerRationale": "The authors and maintainers of KPG 193. Named as publisher because the model is theirs; the Hub holds a converted copy and is the refresh owner of that copy, not of the model."
    }
  ]
