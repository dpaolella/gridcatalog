        "https://catalog.opengrid.org/field/kpg-193/gen-status",
        "https://catalog.opengrid.org/field/kpg-193/gen-cost"
      ],
      "supportedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/dcPowerFlow",
        "https://schema.opengrid.org/concept/analysis-type/acPowerFlow",
        "https://schema.opengrid.org/concept/analysis-type/productionCost"
      ],
      "excludedAnalysis": [
        "https://schema.opengrid.org/concept/analysis-type/resourceAdequacy",
        "https://schema.opengrid.org/concept/analysis-type/capacityExpansion"
      ],
      "exclusionRationale": "The opposite situation from the Hub's other two reference models, and worth stating as such: this one can be solved. The authors validated daily unit commitment and hourly AC OPF across a full year, and the registered snapshot is feasible — no bus outside its voltage limits, no branch over its rating, no unit outside its dispatch limits, 1.26% losses. What it cannot do is anything requiring a year of chronology or a fleet that is allowed to change. Resource adequacy needs the 8,760-hour demand and renewable profiles, which are upstream and not carried in this document. Capacity expansion needs a candidate fleet and the renewable capacity per bus, likewise upstream. Both become available to somebody who fetches the profiles from the source repository; neither is available from this file alone.",
      "questionClassPartition": [
        "https://catalog.opengrid.org/question-class/kpg-193-dispatch-feasibility",
        "https://catalog.opengrid.org/question-class/kpg-193-regional-balance",
        "https://catalog.opengrid.org/question-class/kpg-193-substation-siting",
        "https://catalog.opengrid.org/question-class/kpg-193-voltage-support",
        "https://catalog.opengrid.org/question-class/kpg-193-topology-currency"
      ],
      "schemaPin": "3325d27c8c626a375c7492f1341af139d5686e53",
